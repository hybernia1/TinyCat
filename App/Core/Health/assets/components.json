{
  "health/report": {
    "tag": "div",
    "attrs": {"class": "stack stack-gap-12"},
    "children": [
      {"tag": "h3", "attrs": {"class": "text-lg m-0"}, "children": [{"t": "health.all_checks"}]},
      {
        "tag": "div",
        "attrs": {"class": "disclosure-list"},
        "children": [
          {
            "each": {"get": "report.checks"},
            "as": "check",
            "children": [
              {
                "tag": "details",
                "attrs": {"class": "disclosure-item"},
                "children": [
                  {
                    "tag": "summary",
                    "attrs": {"class": "disclosure-summary"},
                    "children": [
                      {
                        "tag": "span",
                        "attrs": {"class": "cluster gap-2"},
                        "children": [
                          {
                            "tag": "strong",
                            "children": [
                              {
                                "lookup": {"get": "check.id"},
                                "cases": {
                                  "http": {"t": "health.checks.http"},
                                  "database": {"t": "health.checks.database"},
                                  "cache": {"t": "health.checks.cache"},
                                  "storage": {"t": "health.checks.storage"},
                                  "uploads": {"t": "health.checks.uploads"},
                                  "disk": {"t": "health.checks.disk"},
                                  "runtime": {"t": "health.checks.runtime"},
                                  "scheduler": {"t": "health.checks.scheduler"},
                                  "updates": {"t": "health.checks.updates"}
                                },
                                "default": {"get": "check.id"}
                              }
                            ]
                          },
                          {
                            "component": "ui/status-badge",
                            "data": {
                              "tone": {"get": "check.status"},
                              "label": {
                                "lookup": {"get": "check.status"},
                                "cases": {
                                  "ok": {"t": "health.status.ok"},
                                  "warning": {"t": "health.status.warning"},
                                  "critical": {"t": "health.status.critical"},
                                  "skipped": {"t": "health.status.skipped"},
                                  "unknown": {"t": "health.status.unknown"}
                                },
                                "default": {"get": "check.status"}
                              },
                              "text": true
                            }
                          }
                        ]
                      },
                      {"icon": "chevron-down", "class": "icon disclosure-chevron"}
                    ]
                  },
                  {
                    "tag": "div",
                    "attrs": {"class": "disclosure-body stack stack-gap-8"},
                    "children": [
                      {
                        "component": "health/scheduler-findings",
                        "data": {"metrics": {"get": "check.metrics"}},
                        "when": {"eq": [{"get": "check.id"}, "scheduler"]}
                      },
                      {
                        "tag": "span",
                        "attrs": {"class": "table-meta"},
                        "children": [{"t": "health.check_duration"}, ": ", {"get": "check.duration_ms"}, " ms"]
                      },
                      {
                        "tag": "dl",
                        "attrs": {"class": "stack stack-gap-4 m-0"},
                        "when": {"eq": [{"get": "check.id"}, "http"]},
                        "children": [
                          {
                            "each": {"get": "check.metrics"},
                            "as": "value",
                            "children": [
                              {
                                "tag": "div",
                                "attrs": {"class": "split"},
                                "when": {
                                  "lookup": {"get": "_key"},
                                  "cases": {
                                    "ttfb_ms": true,
                                    "total_ms": true,
                                    "dns_ms": true,
                                    "connect_ms": true,
                                    "tls_ms": true,
                                    "http_status": true,
                                    "bytes": true
                                  },
                                  "default": false
                                },
                                "children": [
                                  {
                                    "tag": "dt",
                                    "attrs": {"class": "text-muted"},
                                    "children": [
                                      {
                                        "lookup": {"get": "_key"},
                                        "cases": {
                                          "ttfb_ms": "TTFB (ms)",
                                          "total_ms": {"concat": [{"t": "health.http.total"}, " (ms)"]},
                                          "dns_ms": "DNS (ms)",
                                          "connect_ms": "TCP (ms)",
                                          "tls_ms": "TLS (ms)",
                                          "http_status": "HTTP",
                                          "bytes": "Bytes"
                                        },
                                        "default": {"get": "_key"}
                                      }
                                    ]
                                  },
                                  {
                                    "tag": "dd",
                                    "attrs": {"class": "m-0"},
                                    "children": [{"if": [{"eq": [{"get": "value"}, null]}, "-", {"get": "value"}]}]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "tag": "p",
                        "attrs": {"class": "m-0 table-meta"},
                        "when": {"get": "check.metrics.error"},
                        "children": [
                          {
                            "lookup": {"get": "check.metrics.error"},
                            "cases": {
                              "configuration": {"t": "health.http.errors.configuration"},
                              "unsupported": {"t": "health.http.errors.unsupported"},
                              "timeout": {"t": "health.http.errors.timeout"},
                              "transport": {"t": "health.http.errors.transport"},
                              "response_limit": {"t": "health.http.errors.response_limit"},
                              "disabled": {"t": "health.http.errors.disabled"}
                            },
                            "default": ""
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "health/scheduler-findings": {
    "tag": "ul",
    "attrs": {"class": "result-list"},
    "children": [
      {
        "tag": "li",
        "attrs": {"class": "result-item"},
        "when": {"not": {"get": "metrics"}},
        "children": [{"t": "health.scheduler.unknown"}]
      },
      {
        "each": {"get": "metrics"},
        "as": "reason",
        "children": [
          {
            "tag": "li",
            "attrs": {"class": "result-item"},
            "children": [
              {
                "tag": "strong",
                "children": [
                  {"lookup": {"get": "_key"}, "default": {"get": "_key"}, "catalog": "health.tasks", "field": "label"}
                ]
              },
              " — ",
              {
                "lookup": {"get": "reason"},
                "cases": {
                  "ok": {"t": "health.scheduler.ok"},
                  "missing": {"t": "health.scheduler.missing"},
                  "stale": {"t": "health.scheduler.stale"},
                  "failed": {"t": "health.scheduler.failed"},
                  "interrupted": {"t": "health.scheduler.interrupted"}
                },
                "default": {"t": "health.scheduler.unknown"}
              }
            ]
          }
        ]
      }
    ]
  },
  "health/scheduler-run-detail": {
    "component": "health/report",
    "data": {"report": {"get": "item.summary.health"}},
    "when": {"get": "item.summary.health"}
  }
}
