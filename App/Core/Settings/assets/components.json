{
  "settings/sections": {
    "tag": "div",
    "attrs": {"class": "stack stack-gap-16", "data-editor-sections": ""},
    "children": [
      {
        "each": {"get": "sections"},
        "as": "section",
        "children": {
          "tag": "div",
          "attrs": {
            "class": "grid sm:grid-2",
            "data-editor-section": {"get": "section.key"},
            "data-editor-label": {"get": "section.label"},
            "data-editor-icon": {"get": "section.icon"}
          },
          "children": [
            {
              "each": {"get": "section.fields"},
              "as": "field",
              "children": {
                "component": "settings/field",
                "data": {
                  "root_tag": {"get": "field.root_tag"},
                  "root_class": {"get": "field.root_class"},
                  "kind": {"get": "field.kind"},
                  "label": {"get": "field.label"},
                  "help": {"get": "field.help"},
                  "name": {"get": "field.name"},
                  "value": {"get": "field.value"},
                  "checked": {"get": "field.checked"},
                  "attributes": {"get": "field.attributes"},
                  "options": {"get": "field.options"},
                  "fields": {"get": "field.fields"},
                  "upload_name": {"get": "field.upload_name"},
                  "remove_name": {"get": "field.remove_name"}
                }
              }
            }
          ]
        }
      }
    ]
  },
  "settings/field": {
    "tag": {"get": "root_tag"},
    "attrs": {"class": {"get": "root_class"}},
    "children": [
      {"tag": "span", "attrs": {"class": "label"}, "children": [{"get": "label"}]},
      {"tag": "input", "attrs": {"get": "attributes"}, "when": {"eq": [{"get": "kind"}, "input"]}},
      {
        "tag": "textarea",
        "attrs": {"get": "attributes"},
        "children": [{"get": "value"}],
        "when": {"eq": [{"get": "kind"}, "textarea"]}
      },
      {
        "tag": "select",
        "attrs": {"get": "attributes"},
        "children": [
          {
            "each": {"get": "options"},
            "as": "option",
            "children": {
              "tag": "option",
              "attrs": {"value": {"get": "option.value"}, "selected": {"get": "option.selected"}},
              "children": [{"get": "option.label"}]
            }
          }
        ],
        "when": {"eq": [{"get": "kind"}, "select"]}
      },
      {
        "tag": "input",
        "attrs": {"type": "hidden", "name": {"get": "name"}, "value": "0"},
        "when": {"eq": [{"get": "kind"}, "bool"]}
      },
      {
        "tag": "span",
        "attrs": {"class": "check-line"},
        "children": [
          {
            "tag": "input",
            "attrs": {"type": "checkbox", "name": {"get": "name"}, "value": "1", "checked": {"get": "checked"}}
          },
          {"tag": "span", "children": [{"t": "settings.enabled"}]}
        ],
        "when": {"eq": [{"get": "kind"}, "bool"]}
      },
      {
        "tag": "div",
        "attrs": {"class": "grid sm:grid-2"},
        "children": [
          {
            "each": {"get": "fields"},
            "as": "field",
            "children": {
              "component": "settings/field",
              "data": {
                "root_tag": {"get": "field.root_tag"},
                "root_class": {"get": "field.root_class"},
                "kind": {"get": "field.kind"},
                "label": {"get": "field.label"},
                "help": {"get": "field.help"},
                "name": {"get": "field.name"},
                "value": {"get": "field.value"},
                "checked": {"get": "field.checked"},
                "attributes": {"get": "field.attributes"},
                "options": {"get": "field.options"},
                "fields": {"get": "field.fields"},
                "upload_name": {"get": "field.upload_name"},
                "remove_name": {"get": "field.remove_name"}
              }
            }
          }
        ],
        "when": {"eq": [{"get": "kind"}, "group"]}
      },
      {
        "tag": "input",
        "attrs": {"type": "hidden", "name": {"concat": [{"get": "name"}, "[_present]"]}, "value": "1"},
        "when": {"eq": [{"get": "kind"}, "templates"]}
      },
      {
        "tag": "div",
        "attrs": {"class": "stack gap-2"},
        "children": [
          {
            "each": {"get": "options"},
            "as": "option",
            "children": {
              "tag": "label",
              "attrs": {"class": "check-line"},
              "children": [
                {
                  "tag": "input",
                  "attrs": {
                    "type": "checkbox",
                    "name": {"get": "option.name"},
                    "value": "1",
                    "checked": {"get": "option.selected"}
                  }
                },
                {"tag": "span", "children": [{"get": "option.label"}]}
              ]
            }
          }
        ],
        "when": {"eq": [{"get": "kind"}, "templates"]}
      },
      {
        "tag": "input",
        "attrs": {"type": "hidden", "name": {"get": "name"}, "value": {"get": "value"}},
        "when": {"eq": [{"get": "kind"}, "image"]}
      },
      {
        "tag": "div",
        "attrs": {
          "class": "content-image-preview image-preview-contain",
          "data-empty": {"if": [{"get": "value"}, null, "true"]}
        },
        "children": [
          {"tag": "img", "attrs": {"src": {"get": "value"}, "alt": "", "loading": "lazy"}, "when": {"get": "value"}},
          {
            "tag": "span",
            "attrs": {"class": "content-image-preview-empty"},
            "children": [{"icon": "image"}, {"tag": "span", "children": [{"t": "settings.image_empty"}]}],
            "when": {"not": {"get": "value"}}
          }
        ],
        "when": {"eq": [{"get": "kind"}, "image"]}
      },
      {
        "tag": "div",
        "attrs": {"class": "content-image-actions"},
        "children": [
          {
            "tag": "label",
            "attrs": {"class": "btn btn-secondary btn-sm"},
            "children": [
              {"icon": "upload"},
              {"tag": "span", "children": [{"t": "settings.image_upload"}]},
              {
                "tag": "input",
                "attrs": {
                  "type": "file",
                  "name": {"get": "upload_name"},
                  "accept": "image/jpeg,image/png,image/gif,image/webp",
                  "class": "sr-only"
                }
              }
            ]
          },
          {
            "tag": "label",
            "attrs": {"class": "check-line mb-0"},
            "children": [
              {"tag": "input", "attrs": {"type": "checkbox", "name": {"get": "remove_name"}, "value": "1"}},
              {"tag": "span", "children": [{"t": "settings.image_remove"}]}
            ],
            "when": {"get": "value"}
          }
        ],
        "when": {"eq": [{"get": "kind"}, "image"]}
      },
      {"tag": "span", "attrs": {"class": "help"}, "children": [{"get": "help"}], "when": {"get": "help"}}
    ]
  }
}
