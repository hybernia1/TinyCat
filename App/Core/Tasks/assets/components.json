{
  "scheduler/status": {
    "component": "ui/status-badge",
    "data": {
      "tone": {
        "lookup": {"get": "status"},
        "cases": {
          "completed": "ok",
          "not_due": "ok",
          "has_more": "warning",
          "failed": "critical",
          "interrupted": "critical",
          "running": "primary"
        },
        "default": "unknown"
      },
      "label": {
        "lookup": {"get": "status"},
        "cases": {
          "running": {"t": "cron.statuses.running"},
          "completed": {"t": "cron.statuses.completed"},
          "failed": {"t": "cron.statuses.failed"},
          "not_due": {"t": "cron.statuses.not_due"},
          "has_more": {"t": "cron.statuses.has_more"},
          "interrupted": {"t": "cron.statuses.interrupted"}
        },
        "default": ""
      },
      "text": true
    }
  },
  "scheduler/list": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-14 table-layout",
      "data-scheduler-view": "",
      "data-scheduler-state": {"json": {"get": "state"}},
      "data-admin-list": "core.scheduler-runs",
      "data-admin-state": {
        "json": {
          "filters": {"get": "filters"},
          "pagination": {"get": "pagination"},
          "task_choices": {"get": "task_choices"},
          "status_choices": {"get": "status_choices"}
        }
      }
    },
    "children": [
      {
        "tag": "div",
        "attrs": {"class": "table-wrap"},
        "children": [
          {
            "tag": "table",
            "attrs": {"class": "table", "aria-label": {"t": "cron.list_title"}},
            "children": [
              {
                "tag": "thead",
                "children": [
                  {
                    "tag": "tr",
                    "children": [
                      {"tag": "th", "attrs": {"scope": "col"}, "children": [{"t": "cron.task"}]},
                      {"tag": "th", "attrs": {"scope": "col"}, "children": [{"t": "cron.latest"}]},
                      {"tag": "th", "attrs": {"scope": "col"}, "children": [{"t": "cron.status"}]},
                      {"tag": "th", "attrs": {"scope": "col"}, "children": [{"t": "cron.duration"}]},
                      {"tag": "th", "attrs": {"scope": "col"}, "children": [{"t": "common.actions"}]}
                    ]
                  }
                ]
              },
              {
                "tag": "tbody",
                "children": [
                  {
                    "each": {"get": "items"},
                    "as": "task",
                    "children": [{"component": "scheduler/task-row", "data": {"task": {"get": "task"}}}]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "tag": "section",
        "attrs": {"class": "card"},
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "card-header split"},
            "children": [
              {
                "tag": "h2",
                "attrs": {"class": "text-lg m-0 cluster gap-2"},
                "children": [{"icon": "clock"}, {"t": "cron.history"}]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {"class": "card-body"},
            "children": [
              {
                "tag": "div",
                "attrs": {"class": "stack stack-gap-14 table-layout"},
                "children": [
                  {
                    "component": "ui/list-toolbar",
                    "data": {
                      "url": {"admin_ref": "core.scheduler-runs", "field": "endpoint"},
                      "target": {"admin_ref": "core.scheduler-runs", "field": "target"},
                      "history": {"admin_ref": "core.scheduler-runs", "field": "path"},
                      "filters": {"get": "filters"},
                      "pagination": {"get": "pagination"},
                      "filter_modal": {"admin_ref": "core.scheduler-runs", "field": "filterId"}
                    }
                  },
                  {
                    "tag": "div",
                    "attrs": {"class": "table-wrap"},
                    "children": [
                      {
                        "tag": "table",
                        "attrs": {"class": "table"},
                        "children": [
                          {
                            "tag": "thead",
                            "children": [
                              {
                                "tag": "tr",
                                "children": [
                                  {
                                    "tag": "th",
                                    "attrs": {"scope": "col", "aria-sort": {"get": "sorting.task.aria"}},
                                    "children": [
                                      {
                                        "component": "ui/sort-heading",
                                        "data": {"label": {"t": "cron.task"}, "order": {"get": "sorting.task"}}
                                      }
                                    ]
                                  },
                                  {
                                    "tag": "th",
                                    "attrs": {"scope": "col", "aria-sort": {"get": "sorting.started_at.aria"}},
                                    "children": [
                                      {
                                        "component": "ui/sort-heading",
                                        "data": {"label": {"t": "cron.started"}, "order": {"get": "sorting.started_at"}}
                                      }
                                    ]
                                  },
                                  {
                                    "tag": "th",
                                    "attrs": {"scope": "col", "aria-sort": {"get": "sorting.status.aria"}},
                                    "children": [
                                      {
                                        "component": "ui/sort-heading",
                                        "data": {"label": {"t": "cron.status"}, "order": {"get": "sorting.status"}}
                                      }
                                    ]
                                  },
                                  {
                                    "tag": "th",
                                    "attrs": {"scope": "col", "aria-sort": {"get": "sorting.duration_ms.aria"}},
                                    "children": [
                                      {
                                        "component": "ui/sort-heading",
                                        "data": {
                                          "label": {"t": "cron.duration"},
                                          "order": {"get": "sorting.duration_ms"}
                                        }
                                      }
                                    ]
                                  },
                                  {"tag": "th", "attrs": {"scope": "col"}, "children": [{"t": "cron.result"}]},
                                  {
                                    "tag": "th",
                                    "attrs": {"scope": "col", "class": "table-actions-cell"},
                                    "children": [{"t": "common.actions"}]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "tag": "tbody",
                            "children": [
                              {
                                "each": {"get": "runs"},
                                "as": "run",
                                "children": [
                                  {
                                    "tag": "tr",
                                    "children": [
                                      {
                                        "tag": "td",
                                        "children": [
                                          {
                                            "tag": "div",
                                            "attrs": {"class": "identity-row identity-row-inset"},
                                            "children": [
                                              {
                                                "tag": "span",
                                                "attrs": {"class": "avatar avatar-sm", "aria-hidden": "true"},
                                                "children": [
                                                  {"component": "scheduler/icon", "data": {"name": {"get": "run.task"}}}
                                                ]
                                              },
                                              {
                                                "tag": "div",
                                                "attrs": {"class": "table-identity-body"},
                                                "children": [
                                                  {
                                                    "tag": "span",
                                                    "attrs": {"class": "table-primary"},
                                                    "children": [
                                                      {
                                                        "component": "scheduler/name",
                                                        "data": {"name": {"get": "run.task"}}
                                                      }
                                                    ]
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "td",
                                        "children": [
                                          {
                                            "tag": "div",
                                            "attrs": {"class": "stack stack-gap-4"},
                                            "children": [
                                              {
                                                "tag": "time",
                                                "attrs": {"datetime": {"get": "run.started_at"}},
                                                "when": {"get": "run.started_at"},
                                                "children": [{"date": {"get": "run.started_at"}}]
                                              },
                                              {
                                                "tag": "small",
                                                "attrs": {"class": "cluster gap-2 table-meta"},
                                                "children": [
                                                  {
                                                    "lookup": {"get": "run.mode"},
                                                    "cases": {
                                                      "admin": {"t": "cron.modes.admin"},
                                                      "http": {"t": "cron.modes.http"},
                                                      "cli": {"t": "cron.modes.cli"}
                                                    },
                                                    "default": ""
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "td",
                                        "children": [
                                          {"component": "scheduler/status", "data": {"status": {"get": "run.status"}}}
                                        ]
                                      },
                                      {
                                        "tag": "td",
                                        "children": [
                                          {
                                            "if": [
                                              {"eq": [{"get": "run.duration_ms"}, null]},
                                              "",
                                              {"concat": [{"get": "run.duration_ms"}, " ms"]}
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "td",
                                        "children": [
                                          {
                                            "each": [{"get": "run.summary.count"}, {"get": "run.summary.changed"}],
                                            "as": "metric",
                                            "children": [
                                              {
                                                "tag": "div",
                                                "when": {"not": {"eq": [{"get": "metric"}, null]}},
                                                "children": [
                                                  {
                                                    "lookup": {"string": {"get": "_key"}},
                                                    "cases": {
                                                      "0": {
                                                        "t": "cron.summary_count",
                                                        "values": {"count": {"get": "metric"}}
                                                      },
                                                      "1": {
                                                        "t": "cron.summary_changed",
                                                        "values": {"count": {"get": "metric"}}
                                                      }
                                                    }
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "td",
                                        "attrs": {"class": "table-actions-cell"},
                                        "children": [
                                          {
                                            "tag": "div",
                                            "attrs": {"class": "table-actions"},
                                            "children": [
                                              {
                                                "component": "ui/modal-trigger",
                                                "data": {
                                                  "class": "btn btn-sm btn-ghost btn-icon",
                                                  "modal": {"concat": ["scheduler-run-", {"get": "run.id"}]},
                                                  "url": {"get": "run.detail_url"},
                                                  "label": {"t": "cron.run_details"},
                                                  "icon": "eye",
                                                  "icon_only": true
                                                }
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "tag": "tr",
                                "when": {"not": {"get": "runs"}},
                                "children": [
                                  {
                                    "tag": "td",
                                    "attrs": {"colspan": "6", "class": "text-muted"},
                                    "children": [{"component": "ui/empty-state"}]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "component": "ui/pagination",
                    "data": {
                      "navigation": {"get": "navigation"},
                      "target": {"admin_ref": "core.scheduler-runs", "field": "target"}
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "scheduler/filter-form": {
    "tag": "form",
    "attrs": {
      "class": "stack",
      "method": "get",
      "action": {"admin_ref": "core.scheduler-runs", "field": "endpoint"},
      "data-api-method": "GET",
      "data-ajax-form": "",
      "data-ajax-target": {"admin_ref": "core.scheduler-runs", "field": "target"},
      "data-history": {"admin_ref": "core.scheduler-runs", "field": "path"}
    },
    "children": [
      {"tag": "input", "attrs": {"type": "hidden", "name": "q", "value": {"get": "filters.q"}}},
      {"tag": "input", "attrs": {"type": "hidden", "name": "per_page", "value": {"get": "pagination.per_page"}}},
      {
        "component": "ui/select",
        "data": {
          "label": {"t": "cron.task"},
          "choices": {"options": {"get": "task_choices"}, "all": true, "catalog": "scheduler.tasks", "field": "title"},
          "value": {"get": "filters.task"},
          "attributes": {"class": "select", "name": "task"}
        }
      },
      {
        "component": "ui/select",
        "data": {
          "label": {"t": "cron.status"},
          "choices": {
            "options": {"get": "status_choices"},
            "cases": {
              "running": {"t": "cron.statuses.running"},
              "completed": {"t": "cron.statuses.completed"},
              "failed": {"t": "cron.statuses.failed"},
              "not_due": {"t": "cron.statuses.not_due"},
              "has_more": {"t": "cron.statuses.has_more"},
              "interrupted": {"t": "cron.statuses.interrupted"}
            },
            "all": true
          },
          "value": {"get": "filters.status"},
          "attributes": {"class": "select", "name": "status"}
        }
      }
    ]
  },
  "scheduler/run-detail": {
    "tag": "div",
    "attrs": {"class": "stack stack-gap-16"},
    "children": [
      {
        "tag": "section",
        "attrs": {"class": "stack stack-gap-12"},
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "cluster justify-between gap-2"},
            "children": [
              {
                "tag": "h3",
                "attrs": {"class": "text-lg m-0"},
                "children": [{"component": "scheduler/name", "data": {"name": {"get": "item.task"}}}]
              },
              {"component": "scheduler/status", "data": {"status": {"get": "item.status"}}}
            ]
          },
          {
            "tag": "dl",
            "attrs": {"class": "grid sm:grid-2 gap-2 m-0"},
            "children": [
              {
                "tag": "div",
                "attrs": {"class": "stack stack-gap-4"},
                "children": [
                  {"tag": "dt", "attrs": {"class": "text-muted"}, "children": [{"t": "cron.started"}]},
                  {
                    "tag": "dd",
                    "attrs": {"class": "m-0"},
                    "children": [
                      {
                        "if": [
                          {"eq": [{"get": "item.started_at"}, null]},
                          {"t": "cron.unfinished"},
                          {"date": {"get": "item.started_at"}}
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "div",
                "attrs": {"class": "stack stack-gap-4"},
                "children": [
                  {"tag": "dt", "attrs": {"class": "text-muted"}, "children": [{"t": "cron.duration"}]},
                  {
                    "tag": "dd",
                    "attrs": {"class": "m-0"},
                    "children": [
                      {
                        "if": [
                          {"eq": [{"get": "item.duration_ms"}, null]},
                          {"t": "cron.unfinished"},
                          {"concat": [{"get": "item.duration_ms"}, " ms"]}
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "tag": "section",
        "attrs": {"class": "stack stack-gap-8"},
        "when": {"get": "item.error"},
        "children": [
          {"tag": "h3", "attrs": {"class": "text-lg m-0"}, "children": [{"t": "cron.error"}]},
          {"tag": "p", "attrs": {"class": "is-resource-text text-danger m-0"}, "children": [{"get": "item.error"}]}
        ]
      },
      {
        "tag": "section",
        "attrs": {"class": "stack stack-gap-8"},
        "children": [
          {"tag": "h3", "attrs": {"class": "text-lg m-0"}, "children": [{"t": "cron.result"}]},
          {
            "tag": "div",
            "when": {"not": {"eq": [{"get": "item.summary.count"}, null]}},
            "children": [{"t": "cron.summary_count", "values": {"count": {"get": "item.summary.count"}}}]
          },
          {
            "tag": "div",
            "when": {"not": {"eq": [{"get": "item.summary.changed"}, null]}},
            "children": [{"t": "cron.summary_changed", "values": {"count": {"get": "item.summary.changed"}}}]
          },
          ""
        ]
      },
      {"extensions": "scheduler/run-detail"},
      {
        "tag": "details",
        "attrs": {"class": "disclosure-item"},
        "children": [
          {
            "tag": "summary",
            "attrs": {"class": "disclosure-summary"},
            "children": [
              {"tag": "strong", "children": [{"t": "cron.execution_details"}]},
              {"icon": "chevron-down", "class": "icon disclosure-chevron"}
            ]
          },
          {
            "tag": "div",
            "attrs": {"class": "disclosure-body stack stack-gap-12"},
            "children": [
              {
                "tag": "dl",
                "attrs": {"class": "grid sm:grid-2 gap-2 m-0"},
                "children": [
                  {
                    "tag": "div",
                    "attrs": {"class": "stack stack-gap-4"},
                    "children": [
                      {"tag": "dt", "attrs": {"class": "text-muted"}, "children": [{"t": "cron.finished"}]},
                      {
                        "tag": "dd",
                        "attrs": {"class": "m-0"},
                        "children": [
                          {
                            "if": [
                              {"eq": [{"get": "item.finished_at"}, null]},
                              {"t": "cron.unfinished"},
                              {"date": {"get": "item.finished_at"}}
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "tag": "div",
                    "attrs": {"class": "stack stack-gap-4"},
                    "children": [
                      {"tag": "dt", "attrs": {"class": "text-muted"}, "children": [{"t": "cron.trigger"}]},
                      {
                        "tag": "dd",
                        "attrs": {"class": "m-0"},
                        "children": [
                          {
                            "lookup": {"get": "item.mode"},
                            "cases": {
                              "admin": {"t": "cron.modes.admin"},
                              "http": {"t": "cron.modes.http"},
                              "cli": {"t": "cron.modes.cli"}
                            },
                            "default": ""
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "tag": "div",
                    "attrs": {"class": "stack stack-gap-4"},
                    "children": [
                      {"tag": "dt", "attrs": {"class": "text-muted"}, "children": [{"t": "cron.run_id"}]},
                      {"tag": "dd", "attrs": {"class": "m-0"}, "children": [{"get": "item.id"}]}
                    ]
                  },
                  {
                    "tag": "div",
                    "attrs": {"class": "stack stack-gap-4"},
                    "when": {"get": "item.actor"},
                    "children": [
                      {"tag": "dt", "attrs": {"class": "text-muted"}, "children": [{"t": "cron.actor"}]},
                      {
                        "tag": "dd",
                        "attrs": {"class": "m-0"},
                        "children": [{"or": [{"get": "item.actor.username"}, {"get": "item.actor.id"}]}]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "section",
                "attrs": {"class": "stack stack-gap-8"},
                "when": {"get": "item.options"},
                "children": [
                  {"tag": "h3", "attrs": {"class": "text-lg m-0"}, "children": [{"t": "cron.parameters"}]},
                  {
                    "tag": "dl",
                    "attrs": {"class": "stack stack-gap-4"},
                    "children": [
                      {
                        "each": {"get": "item.options"},
                        "as": "value",
                        "children": [
                          {
                            "tag": "div",
                            "attrs": {"class": "split"},
                            "children": [
                              {
                                "tag": "dt",
                                "attrs": {"class": "text-muted"},
                                "children": [
                                  {
                                    "component": "scheduler/option",
                                    "data": {
                                      "key": {"concat": [{"get": "item.task"}, ":", {"get": "_key"}]},
                                      "name": {"get": "_key"}
                                    }
                                  }
                                ]
                              },
                              {"tag": "dd", "attrs": {"class": "m-0"}, "children": [{"get": "value"}]}
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "scheduler/name": {
    "lookup": {"get": "name"},
    "default": {"get": "name"},
    "catalog": "scheduler.tasks",
    "field": "title"
  },
  "scheduler/icon": {
    "icon": {"lookup": {"get": "name"}, "default": "clock", "catalog": "scheduler.tasks", "field": "icon"}
  },
  "scheduler/option": {
    "lookup": {"get": "key"},
    "default": {"get": "name"},
    "catalog": "scheduler.options",
    "field": "label"
  },
  "scheduler/actions": {
    "tag": "form",
    "attrs": {
      "method": "post",
      "action": "/api/scheduler/tokens",
      "data-ajax-form": "",
      "data-confirm": {"t": "cron.rotate_confirm"}
    },
    "children": [
      {"csrf": true},
      {
        "tag": "button",
        "attrs": {"class": "btn btn-primary", "type": "submit"},
        "children": [{"icon": "refresh"}, " ", {"tag": "span", "children": [{"t": "cron.rotate"}]}]
      }
    ]
  },
  "scheduler/administration": {
    "tag": "div",
    "attrs": {"class": "stack stack-gap-16"},
    "children": [
      {
        "tag": "section",
        "attrs": {
          "class": "stack stack-gap-12",
          "data-configuration-section": "access",
          "data-configuration-label": {"t": "cron.access_title"},
          "data-configuration-icon": "key"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "field"},
            "children": [
              {
                "tag": "span",
                "attrs": {"class": "label cluster gap-2"},
                "children": [
                  {"icon": "globe"},
                  " ",
                  {"t": "cron.url"},
                  {
                    "component": "ui/help",
                    "data": {"text": {"t": "cron.access_help"}, "label": {"t": "cron.access_title"}}
                  }
                ]
              },
              {
                "component": "ui/code-block",
                "data": {"text": {"get": "execution_url"}, "attributes": {"data-scheduler-url": ""}}
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {"class": "field"},
            "children": [
              {
                "tag": "span",
                "attrs": {"class": "label cluster gap-2"},
                "children": [{"icon": "key"}, " ", {"t": "cron.token"}]
              },
              {
                "component": "ui/code-block",
                "data": {"text": {"get": "token"}, "attributes": {"data-scheduler-token": ""}}
              }
            ]
          }
        ]
      },
      {
        "each": {"get": "tasks"},
        "as": "view",
        "children": {
          "tag": "section",
          "attrs": {
            "class": "stack stack-gap-12",
            "data-configuration-section": {"get": "view.id"},
            "data-configuration-label": {
              "lookup": {"get": "view.id"},
              "default": "",
              "catalog": "scheduler.tasks",
              "field": "title"
            },
            "data-configuration-icon": {
              "lookup": {"get": "view.id"},
              "default": "",
              "catalog": "scheduler.tasks",
              "field": "icon"
            }
          },
          "children": [
            {
              "tag": "div",
              "attrs": {"class": "field"},
              "children": [
                {
                  "tag": "span",
                  "attrs": {"class": "label cluster gap-2"},
                  "children": [
                    {"icon": "link"},
                    " ",
                    {"t": "cron.task_url"},
                    {
                      "component": "ui/help",
                      "data": {
                        "text": {
                          "concat": [
                            {"lookup": {"get": "view.id"}, "default": "", "catalog": "scheduler.tasks", "field": "help"},
                            "\n\n",
                            {"t": "cron.query_help"}
                          ]
                        },
                        "label": {"t": "cron.task_url"}
                      }
                    }
                  ]
                },
                {
                  "component": "ui/code-block",
                  "data": {"text": {"get": "view.query_url"}, "attributes": {"data-scheduler-url": ""}}
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {"class": "field"},
              "children": [
                {
                  "tag": "span",
                  "attrs": {"class": "label cluster gap-2"},
                  "children": [{"icon": "globe"}, " ", {"t": "cron.http_command"}]
                },
                {
                  "component": "ui/code-block",
                  "data": {"text": {"get": "view.http_command"}, "attributes": {"data-scheduler-command": ""}}
                }
              ]
            },
            {
              "tag": "div",
              "attrs": {"class": "field"},
              "children": [
                {
                  "tag": "span",
                  "attrs": {"class": "label cluster gap-2"},
                  "children": [{"icon": "code"}, " ", {"t": "cron.cli_command"}]
                },
                {
                  "component": "ui/code-block",
                  "data": {"text": {"get": "view.cli_command"}, "attributes": {"data-scheduler-command": ""}}
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "scheduler/task-row": {
    "tag": "tr",
    "children": [
      {
        "tag": "td",
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "identity-row identity-row-inset"},
            "children": [
              {
                "tag": "span",
                "attrs": {"class": "avatar avatar-sm", "aria-hidden": "true"},
                "children": [{"component": "scheduler/icon", "data": {"name": {"get": "task.name"}}}]
              },
              {
                "tag": "div",
                "attrs": {"class": "table-identity-body"},
                "children": [
                  {
                    "tag": "span",
                    "attrs": {"class": "table-primary"},
                    "children": [{"component": "scheduler/name", "data": {"name": {"get": "task.name"}}}]
                  },
                  {
                    "tag": "div",
                    "attrs": {"class": "table-meta"},
                    "children": [
                      {
                        "tag": "div",
                        "children": [
                          {
                            "lookup": {"get": "task.name"},
                            "default": "",
                            "catalog": "scheduler.tasks",
                            "field": "schedule"
                          }
                        ]
                      },
                      {
                        "each": {"get": "task.options"},
                        "as": "option",
                        "children": [
                          {
                            "tag": "div",
                            "attrs": {"class": "help m-0"},
                            "children": [
                              {
                                "component": "scheduler/option",
                                "data": {
                                  "key": {"concat": [{"get": "task.name"}, ":", {"get": "_key"}]},
                                  "name": {"get": "_key"}
                                }
                              },
                              ": ",
                              {"get": "option"}
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "tag": "td",
        "children": [
          {
            "tag": "time",
            "attrs": {"datetime": {"get": "task.latest.started_at"}, "class": "table-meta"},
            "when": {"get": "task.latest.started_at"},
            "children": [{"date": {"get": "task.latest.started_at"}}]
          },
          {
            "tag": "span",
            "attrs": {"class": "table-meta"},
            "when": {"not": {"get": "task.latest"}},
            "children": [{"t": "cron.never"}]
          }
        ]
      },
      {
        "tag": "td",
        "children": [
          {
            "component": "scheduler/status",
            "data": {"status": {"get": "task.latest.status"}},
            "when": {"get": "task.latest"}
          },
          {"tag": "span", "when": {"not": {"get": "task.latest"}}, "children": ["—"]}
        ]
      },
      {
        "tag": "td",
        "attrs": {"class": "table-meta"},
        "children": [
          {
            "if": [
              {"eq": [{"get": "task.latest.duration_ms"}, null]},
              "—",
              {"concat": [{"get": "task.latest.duration_ms"}, " ms"]}
            ]
          }
        ]
      },
      {
        "tag": "td",
        "attrs": {"class": "table-actions-cell"},
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "table-actions"},
            "children": [
              {
                "component": "ui/api-action",
                "data": {
                  "url": {"get": "task.run_url"},
                  "method": "POST",
                  "target": {"admin_ref": "core.scheduler-runs", "field": "target"},
                  "label": {"t": "cron.run_now"},
                  "icon": "play",
                  "button_class": "btn btn-sm btn-secondary",
                  "show_label": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "scheduler/page": {"tag": "div", "attrs": {"id": {"get": "target_id"}}, "children": [{"slot": {"get": "content"}}]},
  "scheduler/configuration": {
    "tag": "div",
    "attrs": {"class": "stack stack-gap-16"},
    "children": [
      {
        "component": "scheduler/administration",
        "data": {"token": {"get": "token"}, "execution_url": {"get": "execution_url"}, "tasks": {"get": "tasks"}}
      }
    ]
  }
}
