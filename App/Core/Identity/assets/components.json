      {
        "tag": "label",
        "attrs": {"class": "check-line"},
        "when": {"not": {"get": "register"}},
        "children": [
          {"tag": "input", "attrs": {"type": "checkbox", "name": "remember", "value": "1"}},
          {"tag": "span", "children": [{"t": "auth.remember_me"}]}
        ]
      },
      {"component": "ui/captcha", "data": {"config": {"get": "captcha"}}},
      {
        "tag": "button",
        "attrs": {"class": "btn btn-primary", "type": "submit"},
        "children": [
          {"icon": {"if": [{"get": "register"}, "user-plus", "login"]}},
          {"if": [{"get": "register"}, {"t": "common.register"}, {"t": "common.login"}]}
        ]
      }
    ]
  },
  "users/auth-content": {
    "tag": "div",
    "attrs": {"class": "stack"},
    "children": [
      {
        "tag": "p",
        "attrs": {"class": "text-muted mb-0"},
        "when": {"not": {"get": "register"}},
        "children": [{"t": "auth.login_intro"}]
      },
      {"tag": "div", "attrs": {"class": "alert alert-danger"}, "when": {"get": "error"}, "children": [{"get": "error"}]},
      {
        "tag": "div",
        "attrs": {"class": "alert alert-success"},
        "when": {"get": "message"},
        "children": [{"get": "message"}]
      },
      {
        "tag": "div",
        "attrs": {"class": "alert alert-info"},
        "when": {"and": [{"get": "register"}, {"not": {"get": "registration_enabled"}}]},
        "children": [{"t": "auth.registration_disabled"}]
      },
      {
        "component": "users/auth-form",
        "data": {
          "mode": {"get": "mode"},
          "register": {"get": "register"},
          "next": {"get": "next"},
          "form_url": {"get": "form_url"},
          "captcha": {"get": "captcha"},
          "options": {"get": "options"}
        },
        "when": {"not": {"and": [{"get": "register"}, {"not": {"get": "registration_enabled"}}]}}
      },
      {
        "tag": "div",
        "attrs": {"class": "cluster gap-2"},
        "when": {"not": {"get": "register"}},
        "children": [
          {
            "tag": "a",
            "attrs": {"class": "btn btn-ghost btn-sm", "href": "/recovery"},
            "children": [{"icon": "key"}, {"t": "auth.recovery_link"}]
          },
          {
            "tag": "a",
            "attrs": {"class": "btn btn-ghost btn-sm", "href": "/privacy", "rel": "privacy-policy"},
            "children": [{"icon": "shield"}, {"t": "privacy.title"}]
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {"class": "cluster gap-2"},
        "when": {"or": [{"get": "registration_enabled"}, {"get": "register"}]},
        "children": [
          {
            "tag": "span",
            "attrs": {"class": "text-muted"},
            "children": [{"if": [{"get": "register"}, {"t": "auth.has_account"}, {"t": "auth.no_account"}]}]
          },
          {
            "tag": "a",
            "attrs": {
              "class": "btn btn-secondary btn-sm",
              "href": {"get": "switch_url"},
              "data-modal-open": "auth-modal",
              "data-modal-url": {"get": "switch_modal_url"}
            },
            "children": [
              {"icon": {"if": [{"get": "register"}, "login", "user-plus"]}},
              {"if": [{"get": "register"}, {"t": "common.login"}, {"t": "auth.register_link"}]}
            ]
          }
        ]
      }
    ]
  },
  "users/filter-form": {
    "tag": "form",
    "attrs": {
      "class": "stack",
      "method": "get",
      "action": {"admin_ref": "core.users", "field": "endpoint"},
      "data-api-method": "GET",
      "data-ajax-form": "",
      "data-ajax-target": {"admin_ref": "core.users", "field": "target"},
      "data-history": {"admin_ref": "core.users", "field": "path"}
    },
    "children": [
      {"tag": "input", "attrs": {"type": "hidden", "name": "q", "value": {"get": "filters.q"}}},
      {
        "component": "ui/select",
        "data": {
          "label": {"t": "common.role"},
          "attributes": {"class": "select", "name": "role", "disabled": null},
          "value": {"get": "filters.role"},
          "choices": {
            "options": {"get": "roles"},
            "cases": {
              "admin": {"t": "users.roles.admin"},
              "user": {"t": "users.roles.user"},
              "bot": {"t": "users.roles.bot"}
            },
            "all": true
          }
        }
      },
      {
        "component": "ui/select",
        "data": {
          "label": {"t": "common.status"},
          "attributes": {"class": "select", "name": "status", "disabled": null},
          "value": {"get": "filters.status"},
          "choices": {
            "options": {"get": "statuses"},
            "cases": {
              "active": {"t": "users.statuses.active"},
              "waiting": {"t": "users.statuses.waiting"},
              "ban": {"t": "users.statuses.ban"}
            },
            "all": true
          }
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {"t": "common.updated_from"},
          "attributes": {
            "class": "input",
            "name": "updated_from",
            "type": "date",
            "value": {"get": "filters.updated_from"}
          }
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {"t": "common.updated_to"},
          "attributes": {"class": "input", "name": "updated_to", "type": "date", "value": {"get": "filters.updated_to"}}
        }
      },
      {"tag": "input", "attrs": {"type": "hidden", "name": "per_page", "value": {"get": "pagination.per_page"}}},
      {"tag": "input", "attrs": {"type": "hidden", "name": "page", "value": "1"}}
    ]
  },
  "users/avatar-control": {
