    "attrs": {"class": "max-w-auth mx-auto"},
    "children": [
      {
        "tag": "article",
        "attrs": {"class": "card"},
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "card-header"},
            "children": [
              {
                "tag": "h1",
                "attrs": {"class": "text-lg m-0 cluster gap-2"},
