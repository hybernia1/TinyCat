      {"tag": "input", "attrs": {"type": "hidden", "name": "status", "value": "active"}, "when": {"get": "create"}},
      {
        "tag": "div",
        "attrs": {
          "class": "stack stack-gap-16",
          "data-editor-section": "account",
          "data-editor-label": "common.account",
          "data-editor-icon": "user"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "grid sm:grid-2"},
            "children": [
              {
                "component": "ui/field",
                "data": {
                  "label": {"t": "common.username"},
                  "attributes": {
                    "class": "input",
                    "name": {"if": [{"get": "create"}, "username", null]},
                    "value": {"if": [{"get": "create"}, "", {"get": "user.username"}]},
                    "disabled": {"if": [{"not": {"get": "create"}}, true, null]},
                    "required": {"if": [{"get": "create"}, true, null]},
                    "pattern": {"if": [{"get": "create"}, {"get": "options.username_pattern"}, null]},
                    "data-min-length": {"get": "options.username_min_length"},
                    "data-max-length": {"get": "options.username_max_length"},
                    "autocomplete": "username",
                    "autocapitalize": "none",
                    "spellcheck": "false"
                  },
                  "help": {"if": [{"get": "create"}, {"t": "account.username_hint"}, null]}
                }
              },
              {
                "component": "ui/field",
                "data": {
                  "label": {"t": "common.email"},
                  "attributes": {
                    "class": "input",
                    "name": "email",
                    "type": "email",
                    "value": {"get": "user.email"},
                    "data-max-bytes": {"get": "options.email_max_bytes"},
                    "autocomplete": "email",
                    "data-email-check-url": {"concat": ["/api/users/", {"get": "user.id"}, "/email-checks"]}
                  }
                }
              }
            ]
          },
          {
            "component": "ui/field",
            "data": {
              "label": {"t": "account.bio"},
              "value": {"get": "user.bio"},
              "textarea": true,
              "attributes": {
                "class": "textarea",
                "name": "bio",
                "rows": "5",
                "data-max-length": {"get": "options.bio_max_length"}
              }
            },
            "when": {"not": {"get": "create"}}
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "stack stack-gap-16",
          "data-editor-section": "access",
          "data-editor-label": "account.security_settings",
          "data-editor-icon": "lock"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "stack stack-gap-12"},
            "children": [
              {
                "tag": "input",
                "attrs": {"type": "hidden", "name": "role", "value": {"get": "user.role"}},
                "when": {"get": "protected"}
              },
              {
                "component": "ui/select",
                "data": {
                  "label": {"t": "common.role"},
                  "attributes": {
                    "class": "select",
                    "name": {"if": [{"get": "protected"}, "role_locked", "role"]},
                    "disabled": {"if": [{"get": "protected"}, true, null]}
                  },
                  "value": {"or": [{"get": "user.role"}, "user"]},
                  "choices": {
                    "options": {"get": "options.roles"},
                    "cases": {
                      "admin": {"t": "users.roles.admin"},
                      "user": {"t": "users.roles.user"},
                      "bot": {"t": "users.roles.bot"}
                    }
                  }
                }
              }
            ]
          },
          {
            "component": "ui/field",
            "data": {
              "label": {"t": "common.password"},
              "attributes": {
                "class": "input",
                "name": "password",
                "type": "password",
                "value": "",
                "data-min-bytes": {"get": "options.password_min_bytes"},
                "data-max-bytes": {"get": "options.password_max_length"},
                "autocomplete": "new-password",
                "required": {"if": [{"get": "create"}, true, null]}
              }
            }
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "stack stack-gap-16",
          "data-editor-section": "avatar",
          "data-editor-label": "account.avatar",
          "data-editor-icon": "user",
          "data-editor-editable": "false"
        },
        "when": {"not": {"get": "create"}},
        "children": [
          {"tag": "span", "attrs": {"class": "label"}, "children": [{"t": "account.avatar"}]},
          {"component": "users/avatar-control", "data": {"user": {"get": "user"}}}
        ]
      }
    ]
  },
  "users/admin-row": {
    "tag": "tr",
    "attrs": {"class": {"if": [{"eq": [{"get": "user.status"}, "active"]}, null, "table-row-inactive"]}},
    "children": [
      {"tag": "td", "children": [{"component": "users/identity-row", "data": {"user": {"get": "user"}}}]},
      {
        "tag": "td",
        "children": [
          {
            "lookup": {"get": "user.role"},
            "cases": {
              "admin": {"t": "users.roles.admin"},
              "user": {"t": "users.roles.user"},
              "bot": {"t": "users.roles.bot"}
            }
          }
        ]
      },
      {
        "tag": "td",
        "children": [
          {
            "tag": "time",
            "attrs": {"class": "table-meta", "datetime": {"get": "user.updated_at"}},
            "children": [{"date": {"get": "user.updated_at"}}]
          }
        ]
      },
      {
        "tag": "td",
        "attrs": {"class": "table-actions-cell"},
        "children": [
          {
            "tag": "div",
            "attrs": {"class": "table-actions"},
            "children": [
              {
                "component": "ui/modal-trigger",
                "data": {
                  "class": "btn btn-sm btn-ghost btn-icon",
                  "modal": {"concat": ["user-edit-", {"get": "user.id"}]},
                  "url": {"concat": ["/api/users/", {"get": "user.id"}, "/management?panel=administration"]},
                  "label": {"t": "users.edit_user", "values": {"username": {"get": "user.username"}}},
                  "icon": "edit",
                  "icon_only": true
                }
              },
              {
                "component": "ui/activation-action",
                "data": {
                  "active": {"eq": [{"get": "user.status"}, "active"]},
                  "url": {"concat": ["/api/users/", {"get": "user.id"}, "/activation"]},
                  "target": "#users-list"
                },
                "when": {"not": {"get": "user.protected"}}
              },
              {
                "component": "ui/api-action",
                "data": {
                  "url": {"concat": ["/api/users/", {"get": "user.id"}]},
                  "method": "DELETE",
                  "target": "#users-list",
                  "confirm": {"t": "users.delete_confirm", "values": {"username": {"get": "user.username"}}},
                  "label": {"t": "common.delete"},
                  "icon": "trash",
                  "button_class": "btn btn-sm btn-ghost btn-icon text-danger"
                },
                "when": {"get": "user.can_delete"}
              }
            ]
          }
        ]
      }
    ]
  },
  "users/list": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-14 table-layout",
      "data-admin-list": "core.users",
      "data-admin-state": {
        "json": {
          "filters": {"get": "filters"},
          "pagination": {"get": "pagination"},
          "roles": {"get": "roles"},
          "statuses": {"get": "statuses"}
        }
      }
    },
    "children": [
      {
        "component": "ui/list-toolbar",
        "data": {
          "url": {"admin_ref": "core.users", "field": "endpoint"},
          "target": {"admin_ref": "core.users", "field": "target"},
          "history": {"admin_ref": "core.users", "field": "path"},
          "filters": {"get": "filters"},
          "pagination": {"get": "pagination"},
          "filter_modal": {"admin_ref": "core.users", "field": "filterId"}
        }
      },
      {
        "tag": "div",
        "attrs": {"class": "table-wrap"},
        "children": [
          {
            "tag": "table",
            "attrs": {"class": "table"},
            "children": [
              {
                "tag": "thead",
                "children": [
                  {
                    "tag": "tr",
                    "children": [
                      {
                        "tag": "th",
                        "attrs": {"scope": "col", "aria-sort": {"get": "sorting.username.aria"}},
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {"label": {"t": "users.table_user"}, "order": {"get": "sorting.username"}}
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {"scope": "col", "aria-sort": {"get": "sorting.role.aria"}},
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {"label": {"t": "common.role"}, "order": {"get": "sorting.role"}}
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {"scope": "col", "aria-sort": {"get": "sorting.updated_at.aria"}},
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {"label": {"t": "common.updated"}, "order": {"get": "sorting.updated_at"}}
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {"class": "table-actions-cell", "scope": "col"},
                        "children": [{"t": "common.actions"}]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "tbody",
                "children": [
                  {
                    "each": {"get": "items"},
                    "as": "user",
                    "children": [{"component": "users/admin-row", "data": {"user": {"get": "user"}}}]
                  },
                  {
                    "tag": "tr",
                    "when": {"not": {"get": "items"}},
                    "children": [
                      {"tag": "td", "attrs": {"colspan": "4"}, "children": [{"component": "ui/empty-state"}]}
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "component": "ui/pagination",
        "data": {"navigation": {"get": "navigation"}, "target": {"admin_ref": "core.users", "field": "target"}}
      }
    ]
  },
  "users/auth-form": {
    "tag": "form",
    "attrs": {
      "class": "stack",
      "method": "post",
      "action": {"get": "form_url"},
      "data-ajax-form": "",
      "data-ajax-action": {"if": [{"get": "register"}, "/api/users/registrations", "/api/users/sessions"]},
      "data-confirm-unsaved": "true",
      "data-confirm-unsaved-title": {"t": "common.unsaved_title"},
      "data-confirm-unsaved-message": {"t": "common.unsaved_message"},
      "data-confirm-unsaved-ok": {"t": "common.leave"},
      "data-confirm-unsaved-cancel": {"t": "common.stay"}
    },
    "children": [
      {"csrf": true},
      {"tag": "input", "attrs": {"type": "hidden", "name": "next", "value": {"get": "next"}}},
      {
        "component": "ui/field",
        "data": {
          "label": {"t": "auth.login_identifier"},
          "attributes": {
            "class": "input",
            "name": "username",
            "type": "text",
            "autocomplete": "username",
            "required": true,
            "autocapitalize": "none",
            "spellcheck": "false",
            "pattern": {"if": [{"get": "register"}, {"get": "options.username_pattern"}, null]},
            "data-min-length": {"if": [{"get": "register"}, {"get": "options.username_min_length"}, null]},
            "data-max-length": {"if": [{"get": "register"}, {"get": "options.username_max_length"}, null]}
          },
          "help": {"if": [{"get": "register"}, {"t": "account.username_hint"}, null]}
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {"t": "common.email"},
          "attributes": {
            "class": "input",
            "name": "email",
            "type": "email",
            "data-max-bytes": {"get": "options.email_max_bytes"},
            "autocomplete": "email",
            "data-email-check-url": "/api/users/registrations/email-checks"
          }
        },
        "when": {"get": "register"}
      },
      {
        "component": "ui/field",
        "data": {
          "label": {"t": "common.password"},
          "attributes": {
            "class": "input",
            "name": "password",
            "type": "password",
            "value": "",
            "required": true,
            "autocomplete": {"if": [{"get": "register"}, "new-password", "current-password"]},
            "data-max-bytes": {"get": "options.password_max_length"},
            "data-min-bytes": {"if": [{"get": "register"}, {"get": "options.password_min_bytes"}, null]}
          }
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {"t": "common.password_confirm"},
          "attributes": {
            "class": "input",
            "name": "password_confirm",
            "type": "password",
            "value": "",
            "required": true,
            "autocomplete": "new-password",
            "data-min-bytes": {"get": "options.password_min_bytes"}
          }
        },
        "when": {"get": "register"}
      },
      {
        "tag": "label",
        "attrs": {"class": "check-line"},
        "when": {"get": "register"},
        "children": [
          {"tag": "input", "attrs": {"type": "checkbox", "name": "platform_terms", "value": "1", "required": true}},
          {
            "tag": "span",
