{
    "name": "tinycat/tinycat",
    "description": "TinyCat social publishing application",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
        "style": "php tools/style-check.php",
        "test": "php tests/run.php",
        "security": [
            "php tools/security-check.php",
            "composer audit --locked --no-interaction"
        ],
        "preflight": "php tools/preflight.php"
    },
    "config": {
        "allow-plugins": false,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    }
}
