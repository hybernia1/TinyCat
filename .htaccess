DirectoryIndex index.php

<FilesMatch "^(config\.php|.*\.sql)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(App|Extensions|lang|migrations|tests|tools)(/|$)
RedirectMatch 404 "^/storage(?:$|/(?!cache/assets/[A-Za-z0-9._-]+\.(?:css|js)$).*)"

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "^(.+)$" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase Request_URI "\.(css|js|mjs|json|svg|png|jpe?g|gif|webp|avif|ico|woff2?|ttf|otf|eot)$" tinycat_static_asset
    SetEnvIfNoCase Request_URI "^/assets/.*\.(css|js|mjs|json|svg|png|jpe?g|gif|webp|avif|ico|woff2?|ttf|otf|eot)$" tinycat_versioned_asset
    SetEnvIfNoCase Request_URI "^/(?:cache/assets|storage/cache/assets)/[A-Za-z0-9._-]+\.(css|js)$" tinycat_versioned_asset
    SetEnvIfNoCase Request_URI "^/uploads/.*\.(svg|png|jpe?g|gif|webp|avif)$" tinycat_upload_asset
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff" env=tinycat_static_asset
    Header set Cache-Control "public, max-age=31536000, immutable" env=tinycat_versioned_asset
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400" env=tinycat_upload_asset
</IfModule>

<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE \
            text/html \
            text/plain \
            text/css \
            text/javascript \
            text/xml \
            application/javascript \
            application/x-javascript \
            application/json \
            application/ld+json \
            application/xml \
            application/xhtml+xml \
            application/rss+xml \
            application/atom+xml \
            image/svg+xml
    </IfModule>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^cache/assets/([A-Za-z0-9._-]+\.(?:css|js))$ storage/cache/assets/$1 [L]
    RewriteRule ^Public(/.*)?$ index.php [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
