{
  "users/following-profile": {
    "tag": "a",
    "attrs": {
      "class": "profile-following-link",
      "href": {
        "get": "user.url"
      }
    },
    "children": [
      {
        "component": "ui/avatar",
        "data": {
          "user": {
            "get": "user"
          },
          "small": true
        }
      },
      {
        "tag": "span",
        "attrs": {
          "class": "profile-following-main"
        },
        "children": [
          {
            "tag": "strong",
            "attrs": {},
            "children": [
              {
                "get": "user.username"
              }
            ]
          }
        ]
      }
    ]
  },
  "users/admin-fields": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-16",
      "data-editor-sections": ""
    },
    "children": [
      {
        "tag": "input",
        "attrs": {
          "type": "hidden",
          "name": "status",
          "value": "active"
        },
        "when": {
          "get": "create"
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "stack stack-gap-16",
          "data-editor-section": "account",
          "data-editor-label": "common.account",
          "data-editor-icon": "user"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "grid sm:grid-2"
            },
            "children": [
              {
                "tag": "label",
                "attrs": {
                  "class": "field"
                },
                "children": [
                  {
                    "tag": "span",
                    "attrs": {
                      "class": "label"
                    },
                    "children": [
                      {
                        "t": "common.username",
                        "values": {}
                      }
                    ]
                  },
                  {
                    "tag": "input",
                    "attrs": {
                      "class": "input",
                      "name": {
                        "if": [
                          {
                            "get": "create"
                          },
                          "username",
                          null
                        ]
                      },
                      "value": {
                        "if": [
                          {
                            "get": "create"
                          },
                          "",
                          {
                            "get": "user.username"
                          }
                        ]
                      },
                      "disabled": {
                        "if": [
                          {
                            "not": {
                              "get": "create"
                            }
                          },
                          true,
                          null
                        ]
                      },
                      "required": {
                        "if": [
                          {
                            "get": "create"
                          },
                          true,
                          null
                        ]
                      },
                      "pattern": {
                        "if": [
                          {
                            "get": "create"
                          },
                          {
                            "get": "options.username_pattern"
                          },
                          null
                        ]
                      },
                      "minlength": "2",
                      "maxlength": "32",
                      "autocomplete": "username",
                      "autocapitalize": "none",
                      "spellcheck": "false"
                    },
                    "children": []
                  },
                  {
                    "tag": "span",
                    "when": {
                      "get": "create"
                    },
                    "attrs": {
                      "class": "help"
                    },
                    "children": [
                      {
                        "t": "account.username_hint"
                      }
                    ]
                  }
                ]
              },
              {
                "component": "ui/field",
                "data": {
                  "label": {
                    "t": "common.email",
                    "values": {}
                  },
                  "value": {
                    "get": "user.email"
                  },
                  "textarea": false,
                  "attributes": {
                    "class": "input",
                    "name": "email",
                    "type": "email",
                    "value": {
                      "get": "user.email"
                    },
                    "maxlength": "254",
                    "autocomplete": "email",
                    "data-email-check-url": {
                      "concat": [
                        "/api/users/",
                        {
                          "get": "user.id"
                        },
                        "/email-checks"
                      ]
                    }
                  }
                }
              }
            ]
          },
          {
            "component": "ui/field",
            "data": {
              "label": {
                "t": "account.bio",
                "values": {}
              },
              "value": {
                "get": "user.bio"
              },
              "textarea": true,
              "attributes": {
                "class": "textarea",
                "name": "bio",
                "rows": "5",
                "maxlength": "500"
              }
            },
            "when": {
              "not": {
                "get": "create"
              }
            }
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "stack stack-gap-16",
          "data-editor-section": "access",
          "data-editor-label": "account.security_settings",
          "data-editor-icon": "lock"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "stack stack-gap-12"
            },
            "children": [
              {
                "tag": "input",
                "attrs": {
                  "type": "hidden",
                  "name": "role",
                  "value": {
                    "get": "user.role"
                  }
                },
                "children": [],
                "when": {
                  "get": "protected"
                }
              },
              {
                "component": "ui/select",
                "data": {
                  "label": {
                    "t": "common.role",
                    "values": {}
                  },
                  "attributes": {
                    "class": "select",
                    "name": {
                      "if": [
                        {
                          "get": "protected"
                        },
                        "role_locked",
                        "role"
                      ]
                    },
                    "disabled": {
                      "if": [
                        {
                          "get": "protected"
                        },
                        true,
                        null
                      ]
                    }
                  },
                  "value": {
                    "or": [
                      {
                        "get": "user.role"
                      },
                      "user"
                    ]
                  },
                  "choices": {
                    "options": {
                      "get": "options.roles"
                    },
                    "cases": {
                      "admin": {
                        "t": "users.roles.admin"
                      },
                      "user": {
                        "t": "users.roles.user"
                      },
                      "bot": {
                        "t": "users.roles.bot"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "component": "ui/field",
            "data": {
              "label": {
                "t": "common.password",
                "values": {}
              },
              "value": "",
              "textarea": false,
              "attributes": {
                "class": "input",
                "name": "password",
                "type": "password",
                "value": "",
                "minlength": "8",
                "maxlength": {
                  "get": "options.password_max_length"
                },
                "autocomplete": "new-password",
                "required": {
                  "if": [
                    {
                      "get": "create"
                    },
                    true,
                    null
                  ]
                }
              }
            }
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "stack stack-gap-16",
          "data-editor-section": "avatar",
          "data-editor-label": "account.avatar",
          "data-editor-icon": "user",
          "data-editor-editable": "false"
        },
        "children": [
          {
            "tag": "span",
            "attrs": {
              "class": "label"
            },
            "children": [
              {
                "t": "account.avatar",
                "values": {}
              }
            ]
          },
          {
            "component": "users/avatar-control",
            "data": {
              "user": {
                "get": "user"
              }
            }
          }
        ],
        "when": {
          "not": {
            "get": "create"
          }
        }
      }
    ]
  },
  "users/admin-row": {
    "tag": "tr",
    "attrs": {
      "class": {
        "if": [
          {
            "eq": [
              {
                "get": "user.status"
              },
              "active"
            ]
          },
          null,
          "table-row-inactive"
        ]
      }
    },
    "children": [
      {
        "tag": "td",
        "attrs": {},
        "children": [
          {
            "tag": "strong",
            "attrs": {},
            "children": [
              {
                "concat": [
                  "@",
                  {
                    "get": "user.username"
                  }
                ]
              }
            ]
          },
          {
            "tag": "span",
            "attrs": {
              "class": "sr-only"
            },
            "children": [
              {
                "lookup": {
                  "get": "user.status"
                },
                "cases": {
                  "active": {
                    "t": "users.statuses.active"
                  },
                  "waiting": {
                    "t": "users.statuses.waiting"
                  },
                  "ban": {
                    "t": "users.statuses.ban"
                  }
                }
              }
            ]
          },
          {
            "tag": "span",
            "attrs": {
              "class": "sr-only"
            },
            "children": [
              {
                "lookup": {
                  "get": "user.status"
                },
                "cases": {
                  "active": {
                    "t": "users.statuses.active"
                  },
                  "waiting": {
                    "t": "users.statuses.waiting"
                  },
                  "ban": {
                    "t": "users.statuses.ban"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "tag": "td",
        "attrs": {},
        "children": [
          {
            "lookup": {
              "get": "user.role"
            },
            "cases": {
              "admin": {
                "t": "users.roles.admin"
              },
              "user": {
                "t": "users.roles.user"
              },
              "bot": {
                "t": "users.roles.bot"
              }
            }
          }
        ]
      },
      {
        "tag": "td",
        "attrs": {},
        "children": [
          {
            "tag": "time",
            "attrs": {
              "class": "table-meta",
              "datetime": {
                "get": "user.updated_at"
              }
            },
            "children": [
              {
                "date": {
                  "get": "user.updated_at"
                }
              }
            ]
          }
        ]
      },
      {
        "tag": "td",
        "attrs": {
          "class": "table-actions-cell"
        },
        "children": [
          {
            "tag": "div",
            "attrs": {
              "class": "table-actions"
            },
            "children": [
              {
                "component": "ui/modal-trigger",
                "data": {
                  "class": "btn btn-sm btn-ghost btn-icon",
                  "modal": {
                    "concat": [
                      "user-edit-",
                      {
                        "get": "user.id"
                      }
                    ]
                  },
                  "url": {
                    "concat": [
                      "/api/users/",
                      {
                        "get": "user.id"
                      },
                      "/management?panel=administration"
                    ]
                  },
                  "label": {
                    "t": "users.edit_user",
                    "values": {
                      "username": {
                        "get": "user.username"
                      }
                    }
                  },
                  "icon": "edit",
                  "icon_only": true
                }
              },
              {
                "component": "ui/activation-action",
                "data": {
                  "active": {
                    "eq": [
                      {
                        "get": "user.status"
                      },
                      "active"
                    ]
                  },
                  "url": {
                    "concat": [
                      "/api/users/",
                      {
                        "get": "user.id"
                      },
                      "/activation"
                    ]
                  },
                  "target": "#users-list"
                },
                "when": {
                  "not": {
                    "get": "user.protected"
                  }
                }
              },
              {
                "component": "ui/api-action",
                "data": {
                  "url": {
                    "concat": [
                      "/api/users/",
                      {
                        "get": "user.id"
                      }
                    ]
                  },
                  "method": "DELETE",
                  "target": "#users-list",
                  "confirm": {
                    "t": "users.delete_confirm",
                    "values": {
                      "username": {
                        "get": "user.username"
                      }
                    }
                  },
                  "label": {
                    "t": "common.delete"
                  },
                  "icon": "trash",
                  "button_class": "btn btn-sm btn-ghost btn-icon text-danger"
                },
                "when": {
                  "get": "user.can_delete"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "users/list": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-14",
      "data-users-view": "",
      "data-users-state": {
        "json": {
          "get": "state"
        }
      }
    },
    "children": [
      {
        "component": "ui/list-toolbar",
        "data": {
          "url": "/api/users",
          "target": "#users-list",
          "history": "/admin/users",
          "filters": {
            "get": "filters"
          },
          "pagination": {
            "get": "pagination"
          },
          "filter_modal": "users-filter-modal"
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "table-wrap"
        },
        "children": [
          {
            "tag": "table",
            "attrs": {
              "class": "table"
            },
            "children": [
              {
                "tag": "thead",
                "attrs": {},
                "children": [
                  {
                    "tag": "tr",
                    "attrs": {},
                    "children": [
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.username.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "users.table_user",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.username"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.role.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "common.role",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.role"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.updated_at.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "common.updated",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.updated_at"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "class": "table-actions-cell",
                          "scope": "col"
                        },
                        "children": [
                          {
                            "t": "common.actions",
                            "values": {}
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "tbody",
                "attrs": {},
                "children": [
                  {
                    "each": {
                      "get": "items"
                    },
                    "as": "user",
                    "children": [
                      {
                        "component": "users/admin-row",
                        "data": {
                          "user": {
                            "get": "user"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "tag": "tr",
                    "attrs": {},
                    "children": [
                      {
                        "tag": "td",
                        "attrs": {
                          "colspan": "4"
                        },
                        "children": [
                          {
                            "component": "ui/empty-state"
                          }
                        ]
                      }
                    ],
                    "when": {
                      "not": {
                        "get": "items"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "component": "ui/pagination",
        "data": {
          "navigation": {
            "get": "navigation"
          },
          "target": "#users-list"
        }
      }
    ]
  },
  "users/auth-form": {
    "tag": "form",
    "attrs": {
      "class": "stack",
      "method": "post",
      "action": {
        "get": "form_url"
      },
      "data-ajax-form": "",
      "data-ajax-action": {
        "if": [
          {
            "get": "register"
          },
          "/api/users/registrations",
          "/api/users/sessions"
        ]
      },
      "data-confirm-unsaved": "true",
      "data-confirm-unsaved-title": {
        "t": "common.unsaved_title",
        "values": {}
      },
      "data-confirm-unsaved-message": {
        "t": "common.unsaved_message",
        "values": {}
      },
      "data-confirm-unsaved-ok": {
        "t": "common.leave",
        "values": {}
      },
      "data-confirm-unsaved-cancel": {
        "t": "common.stay",
        "values": {}
      }
    },
    "children": [
      {
        "csrf": true
      },
      {
        "tag": "input",
        "attrs": {
          "type": "hidden",
          "name": "next",
          "value": {
            "get": "next"
          }
        },
        "children": []
      },
      {
        "component": "ui/field",
        "data": {
          "label": {
            "t": "auth.login_identifier",
            "values": {}
          },
          "value": {
            "get": "old.username"
          },
          "textarea": false,
          "attributes": {
            "class": "input",
            "name": "username",
            "type": "text",
            "value": {
              "get": "old.username"
            },
            "autocomplete": "username",
            "required": true,
            "autocapitalize": "none",
            "spellcheck": "false",
            "pattern": {
              "if": [
                {
                  "get": "register"
                },
                {
                  "get": "options.username_pattern"
                },
                null
              ]
            },
            "minlength": {
              "if": [
                {
                  "get": "register"
                },
                "2",
                null
              ]
            },
            "maxlength": {
              "if": [
                {
                  "get": "register"
                },
                "32",
                null
              ]
            }
          }
        }
      },
      {
        "tag": "span",
        "attrs": {
          "class": "help"
        },
        "children": [
          {
            "t": "account.username_hint"
          }
        ],
        "when": {
          "get": "register"
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {
            "t": "common.email",
            "values": {}
          },
          "value": {
            "get": "old.email"
          },
          "textarea": false,
          "attributes": {
            "class": "input",
            "name": "email",
            "type": "email",
            "value": {
              "get": "old.email"
            },
            "maxlength": "254",
            "autocomplete": "email",
            "data-email-check-url": "/api/users/registrations/email-checks"
          }
        },
        "when": {
          "get": "register"
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {
            "t": "common.password",
            "values": {}
          },
          "value": "",
          "textarea": false,
          "attributes": {
            "class": "input",
            "name": "password",
            "type": "password",
            "value": "",
            "required": true,
            "autocomplete": {
              "if": [
                {
                  "get": "register"
                },
                "new-password",
                "current-password"
              ]
            },
            "maxlength": {
              "get": "options.password_max_length"
            },
            "minlength": {
              "if": [
                {
                  "get": "register"
                },
                "8",
                null
              ]
            }
          }
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {
            "t": "common.password_confirm",
            "values": {}
          },
          "value": "",
          "textarea": false,
          "attributes": {
            "class": "input",
            "name": "password_confirm",
            "type": "password",
            "value": "",
            "required": true,
            "autocomplete": "new-password",
            "minlength": "8"
          }
        },
        "when": {
          "get": "register"
        }
      },
      {
        "tag": "label",
        "attrs": {
          "class": "check-line"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "checkbox",
              "name": "platform_terms",
              "value": "1",
              "required": true,
              "checked": {
                "if": [
                  {
                    "get": "old.platform_terms"
                  },
                  true,
                  null
                ]
              }
            },
            "children": []
          },
          {
            "tag": "span",
            "attrs": {},
            "children": [
              {
                "t": "auth.platform_terms_agree",
                "values": {}
              },
              " ",
              {
                "tag": "a",
                "attrs": {
                  "href": "/privacy",
                  "target": "_blank",
                  "rel": "privacy-policy"
                },
                "children": [
                  {
                    "t": "privacy.title",
                    "values": {}
                  }
                ]
              }
            ]
          }
        ],
        "when": {
          "get": "register"
        }
      },
      {
        "tag": "label",
        "attrs": {
          "class": "check-line"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "checkbox",
              "name": "remember",
              "value": "1",
              "checked": {
                "if": [
                  {
                    "get": "old.remember"
                  },
                  true,
                  null
                ]
              }
            },
            "children": []
          },
          {
            "tag": "span",
            "attrs": {},
            "children": [
              {
                "t": "auth.remember_me",
                "values": {}
              }
            ]
          }
        ],
        "when": {
          "not": {
            "get": "register"
          }
        }
      },
      {
        "component": "ui/captcha",
        "data": {
          "config": {
            "get": "captcha"
          }
        }
      },
      {
        "tag": "button",
        "attrs": {
          "class": "btn btn-primary",
          "type": "submit"
        },
        "children": [
          {
            "icon": {
              "if": [
                {
                  "get": "register"
                },
                "user-plus",
                "login"
              ]
            }
          },
          {
            "if": [
              {
                "get": "register"
              },
              {
                "t": "common.register",
                "values": {}
              },
              {
                "t": "common.login",
                "values": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "users/auth-content": {
    "tag": "div",
    "attrs": {
      "class": "stack"
    },
    "children": [
      {
        "tag": "p",
        "attrs": {
          "class": "text-muted mb-0"
        },
        "children": [
          {
            "t": "auth.login_intro",
            "values": {}
          }
        ],
        "when": {
          "not": {
            "get": "register"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-danger"
        },
        "children": [
          {
            "get": "error"
          }
        ],
        "when": {
          "get": "error"
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-success"
        },
        "children": [
          {
            "get": "message"
          }
        ],
        "when": {
          "get": "message"
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-info"
        },
        "children": [
          {
            "t": "auth.registration_disabled",
            "values": {}
          }
        ],
        "when": {
          "and": [
            {
              "get": "register"
            },
            {
              "not": {
                "get": "registration_enabled"
              }
            }
          ]
        }
      },
      {
        "component": "users/auth-form",
        "data": {
          "mode": {
            "get": "mode"
          },
          "register": {
            "get": "register"
          },
          "next": {
            "get": "next"
          },
          "form_url": {
            "get": "form_url"
          },
          "captcha": {
            "get": "captcha"
          },
          "options": {
            "get": "options"
          },
          "old": {
            "get": "old"
          }
        },
        "when": {
          "not": {
            "and": [
              {
                "get": "register"
              },
              {
                "not": {
                  "get": "registration_enabled"
                }
              }
            ]
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "cluster gap-2"
        },
        "children": [
          {
            "tag": "a",
            "attrs": {
              "class": "btn btn-ghost btn-sm",
              "href": "/recovery"
            },
            "children": [
              {
                "icon": "key"
              },
              {
                "t": "auth.recovery_link",
                "values": {}
              }
            ]
          },
          {
            "tag": "a",
            "attrs": {
              "class": "btn btn-ghost btn-sm",
              "href": "/privacy",
              "rel": "privacy-policy"
            },
            "children": [
              {
                "icon": "shield"
              },
              {
                "t": "privacy.title",
                "values": {}
              }
            ]
          }
        ],
        "when": {
          "not": {
            "get": "register"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "cluster gap-2"
        },
        "children": [
          {
            "tag": "span",
            "attrs": {
              "class": "text-muted"
            },
            "children": [
              {
                "if": [
                  {
                    "get": "register"
                  },
                  {
                    "t": "auth.has_account",
                    "values": {}
                  },
                  {
                    "t": "auth.no_account",
                    "values": {}
                  }
                ]
              }
            ]
          },
          {
            "tag": "a",
            "attrs": {
              "class": "btn btn-secondary btn-sm",
              "href": {
                "get": "switch_url"
              },
              "data-modal-open": "auth-modal",
              "data-modal-url": {
                "get": "switch_modal_url"
              },
              "data-modal-refresh": "true"
            },
            "children": [
              {
                "icon": {
                  "if": [
                    {
                      "get": "register"
                    },
                    "login",
                    "user-plus"
                  ]
                }
              },
              {
                "if": [
                  {
                    "get": "register"
                  },
                  {
                    "t": "common.login",
                    "values": {}
                  },
                  {
                    "t": "auth.register_link",
                    "values": {}
                  }
                ]
              }
            ]
          }
        ],
        "when": {
          "or": [
            {
              "get": "registration_enabled"
            },
            {
              "get": "register"
            }
          ]
        }
      }
    ]
  },
  "users/filter-form": {
