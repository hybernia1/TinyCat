              },
              {
                "t": "common.login",
                "values": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "users/auth-content": {
    "tag": "div",
    "attrs": {
      "class": "stack"
    },
    "children": [
      {
        "tag": "p",
        "attrs": {
          "class": "text-muted mb-0"
        },
        "children": [
          {
            "t": "auth.login_intro",
            "values": {}
          }
        ],
        "when": {
          "not": {
            "get": "register"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-danger"
        },
        "children": [
          {
            "get": "error"
          }
        ],
        "when": {
          "get": "error"
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-success"
        },
        "children": [
          {
            "get": "message"
          }
        ],
        "when": {
          "get": "message"
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-info"
        },
        "children": [
          {
            "t": "auth.registration_disabled",
            "values": {}
          }
        ],
        "when": {
          "and": [
            {
              "get": "register"
            },
            {
              "not": {
                "get": "registration_enabled"
              }
            }
          ]
        }
      },
      {
        "component": "users/auth-form",
        "data": {
          "mode": {
            "get": "mode"
          },
          "register": {
            "get": "register"
          },
          "next": {
            "get": "next"
          },
          "form_url": {
            "get": "form_url"
          },
          "captcha": {
            "get": "captcha"
          },
          "options": {
            "get": "options"
          },
          "old": {
            "get": "old"
          }
        },
        "when": {
          "not": {
            "and": [
              {
                "get": "register"
              },
              {
                "not": {
                  "get": "registration_enabled"
                }
              }
            ]
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "cluster gap-2"
        },
        "children": [
          {
            "tag": "a",
            "attrs": {
              "class": "btn btn-ghost btn-sm",
              "href": "/recovery"
            },
            "children": [
              {
                "icon": "key"
              },
              {
                "t": "auth.recovery_link",
                "values": {}
              }
            ]
          },
          {
            "tag": "a",
            "attrs": {
              "class": "btn btn-ghost btn-sm",
              "href": "/privacy"
            },
            "children": [
              {
                "icon": "shield"
              },
              {
                "t": "privacy.title",
                "values": {}
              }
            ]
          }
        ],
        "when": {
          "not": {
            "get": "register"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "cluster gap-2"
        },
        "children": [
          {
            "tag": "span",
            "attrs": {
              "class": "text-muted"
            },
            "children": [
              {
                "if": [
                  {
                    "get": "register"
                  },
                  {
                    "t": "auth.has_account",
                    "values": {}
                  },
                  {
                    "t": "auth.no_account",
                    "values": {}
                  }
                ]
              }
            ]
          },
          {
            "tag": "a",
            "attrs": {
              "class": "btn btn-secondary btn-sm",
              "href": {
                "get": "switch_url"
              },
              "data-modal-open": "auth-modal",
              "data-modal-url": {
                "get": "switch_modal_url"
              },
              "data-modal-refresh": "true"
            },
            "children": [
              {
                "icon": {
                  "if": [
                    {
                      "get": "register"
                    },
                    "login",
                    "user-plus"
                  ]
                }
              },
              {
                "if": [
                  {
                    "get": "register"
                  },
                  {
                    "t": "common.login",
                    "values": {}
                  },
                  {
                    "t": "auth.register_link",
                    "values": {}
                  }
                ]
              }
            ]
          }
        ],
        "when": {
          "or": [
            {
              "get": "registration_enabled"
            },
            {
              "get": "register"
            }
          ]
        }
      }
    ]
  },
