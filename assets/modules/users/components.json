          }
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {
            "t": "common.updated_to",
            "values": {}
          },
          "value": {
            "get": "filters.updated_to"
          },
          "textarea": false,
          "attributes": {
            "class": "input",
            "name": "updated_to",
            "type": "date",
            "value": {
              "get": "filters.updated_to"
            }
          }
        }
      },
      {
        "component": "ui/select",
        "data": {
          "label": {
            "t": "common.per_page",
