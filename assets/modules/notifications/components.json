{
  "notifications/copy": {
    "tag": "span",
    "attrs": {
      "class": {
        "if": [
          {
            "get": "preview"
          },
          "notification-popover-copy",
          "notification-copy"
        ]
      }
    },
    "children": [
      {
        "tag": "strong",
        "attrs": {},
        "children": [
          {
            "lookup": {
              "get": "item.type"
            },
            "cases": {
              "follow": {
                "t": "notifications.messages.follow",
                "values": {
                  "actor": {
                    "or": [
                      {
                        "get": "item.actor.username"
                      },
                      {
                        "t": "notifications.someone"
                      }
                    ]
                  }
                }
              },
              "content_like": {
                "t": "notifications.messages.content_like",
                "values": {
                  "actor": {
                    "or": [
                      {
                        "get": "item.actor.username"
                      },
                      {
                        "t": "notifications.someone"
                      }
                    ]
                  }
                }
              },
              "comment_like": {
                "t": "notifications.messages.comment_like",
                "values": {
                  "actor": {
                    "or": [
                      {
                        "get": "item.actor.username"
                      },
                      {
                        "t": "notifications.someone"
                      }
                    ]
                  }
                }
              },
              "content_comment": {
                "t": "notifications.messages.content_comment",
                "values": {
                  "actor": {
                    "or": [
                      {
                        "get": "item.actor.username"
                      },
                      {
                        "t": "notifications.someone"
                      }
                    ]
                  }
                }
              },
              "content_mention": {
                "t": "notifications.messages.content_mention",
                "values": {
                  "actor": {
                    "or": [
                      {
                        "get": "item.actor.username"
                      },
                      {
                        "t": "notifications.someone"
                      }
                    ]
                  }
                }
              },
              "comment_mention": {
                "t": "notifications.messages.comment_mention",
                "values": {
                  "actor": {
                    "or": [
                      {
                        "get": "item.actor.username"
                      },
                      {
                        "t": "notifications.someone"
                      }
                    ]
                  }
                }
              },
              "report_resolved": {
                "t": "notifications.messages.report_resolved",
                "values": {
                  "actor": {
                    "or": [
                      {
                        "get": "item.actor.username"
                      },
                      {
                        "t": "notifications.someone"
                      }
                    ]
                  }
                }
              },
              "report_dismissed": {
                "t": "notifications.messages.report_dismissed",
                "values": {
                  "actor": {
                    "or": [
                      {
                        "get": "item.actor.username"
                      },
                      {
                        "t": "notifications.someone"
                      }
                    ]
                  }
                }
              }
            },
            "default": {
              "t": "notifications.messages.generic",
              "values": {
                "actor": {
                  "or": [
                    {
                      "get": "item.actor.username"
                    },
                    {
                      "t": "notifications.someone"
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      {
        "tag": "span",
        "attrs": {},
        "children": [
          {
            "get": "item.excerpt"
          }
        ],
        "when": {
          "get": "item.excerpt"
        }
      },
      {
        "tag": "time",
        "attrs": {
          "datetime": {
            "get": "item.created_at"
          }
        },
        "children": [
          {
            "date": {
              "get": "item.created_at"
            }
          }
        ],
        "when": {
          "get": "item.created_at"
        }
      }
    ]
  },
  "notifications/action": {
    "tag": "form",
    "attrs": {
      "method": "post",
      "action": {
        "concat": [
          "/api/notifications/",
          {
            "get": "item.id"
          }
        ]
      },
      "data-api-method": {
        "get": "method"
      },
      "data-ajax-form": "",
      "data-ajax-target": "#notifications-view"
    },
    "children": [
      {
        "csrf": true
      },
      {
        "tag": "input",
        "attrs": {
          "type": "hidden",
          "name": "id",
          "value": {
            "get": "item.id"
          }
        },
        "children": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": {
            "concat": [
              "btn btn-ghost btn-icon btn-sm",
              {
                "if": [
                  {
                    "eq": [
                      {
                        "get": "method"
                      },
                      "DELETE"
                    ]
                  },
                  " text-danger",
                  ""
                ]
              }
            ]
          },
          "type": "submit",
          "aria-label": {
            "if": [
              {
                "eq": [
                  {
                    "get": "method"
                  },
                  "DELETE"
                ]
              },
              {
                "t": "notifications.delete",
                "values": {}
              },
              {
                "t": "notifications.mark_read",
                "values": {}
              }
            ]
          }
        },
        "children": [
          {
            "icon": {
              "if": [
                {
                  "eq": [
                    {
                      "get": "method"
                    },
                    "DELETE"
                  ]
                },
                "trash",
                "check"
              ]
            }
          }
        ]
      }
    ]
  },
  "notifications/item": {
    "tag": "article",
    "attrs": {
      "class": {
        "concat": [
          "notification-item",
          {
            "if": [
              {
                "get": "item.unread"
              },
              " is-unread",
              ""
            ]
          }
        ]
      },
      "data-notification-id": {
        "get": "item.id"
      }
    },
    "children": [
      {
        "tag": "a",
        "attrs": {
          "class": "notification-main",
          "href": {
            "get": "item.url"
          }
        },
        "children": [
          {
            "tag": "span",
            "attrs": {
              "class": "notification-avatar"
            },
            "children": [
              {
                "component": "ui/avatar-content",
                "data": {
                  "user": {
                    "get": "item.actor"
                  },
                  "alt": {
                    "get": "item.actor.username"
                  },
                  "fallback_icon": {
                    "lookup": {
                      "get": "item.type"
                    },
                    "cases": {
                      "follow": "user-plus",
                      "content_like": "thumb-up",
                      "comment_like": "thumb-up",
                      "content_comment": "message-circle",
                      "content_mention": "user",
                      "comment_mention": "user",
                      "report_resolved": "check",
                      "report_dismissed": "flag"
                    },
                    "default": "bell"
                  }
                }
              }
            ]
          },
          {
            "component": "notifications/copy",
            "data": {
              "item": {
                "get": "item"
              }
            }
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "notification-actions"
        },
        "children": [
          {
            "component": "notifications/action",
            "data": {
              "item": {
                "get": "item"
              },
              "method": "PATCH"
            },
            "when": {
              "get": "item.unread"
            }
          },
          {
            "component": "notifications/action",
            "data": {
              "item": {
                "get": "item"
              },
              "method": "DELETE"
            }
          }
        ]
      }
    ]
  },
  "notifications/preview-item": {
    "tag": "a",
    "attrs": {
      "class": {
        "concat": [
          "notification-popover-item",
          {
            "if": [
              {
                "get": "item.unread"
              },
              " is-unread",
              ""
            ]
          }
        ]
      },
      "data-notification-id": {
        "get": "item.id"
      },
      "href": {
        "get": "item.url"
      }
    },
    "children": [
      {
        "tag": "span",
        "attrs": {
          "class": "notification-popover-avatar"
        },
        "children": [
          {
            "component": "ui/avatar-content",
            "data": {
              "user": {
                "get": "item.actor"
              },
              "alt": {
                "get": "item.actor.username"
              },
              "fallback_icon": {
                "lookup": {
                  "get": "item.type"
                },
                "cases": {
                  "follow": "user-plus",
                  "content_like": "thumb-up",
                  "comment_like": "thumb-up",
                  "content_comment": "message-circle",
                  "content_mention": "user",
                  "comment_mention": "user",
                  "report_resolved": "check",
                  "report_dismissed": "flag"
                },
                "default": "bell"
              }
            }
          }
        ]
      },
      {
        "component": "notifications/copy",
        "data": {
          "item": {
            "get": "item"
          },
          "preview": true
        }
      }
    ]
  },
  "notifications/items": [
    {
      "tag": "div",
      "attrs": {
        "class": {
          "if": [
            {
              "get": "preview"
            },
            "notification-popover-empty",
            "notification-empty"
          ]
        }
      },
      "children": [
        {
          "icon": "bell"
        },
        {
          "t": "notifications.empty",
          "values": {}
        }
      ],
      "when": {
        "not": {
          "get": "items"
        }
      }
    },
    {
      "each": {
        "get": "items"
      },
      "as": "item",
      "children": [
        {
          "component": "notifications/preview-item",
          "data": {
            "item": {
              "get": "item"
            }
          },
          "when": {
            "get": "preview"
          }
        },
        {
          "component": "notifications/item",
          "data": {
            "item": {
              "get": "item"
            }
          },
          "when": {
            "not": {
              "get": "preview"
            }
          }
        }
      ]
    }
  ]
}
