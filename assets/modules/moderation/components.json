                                "tag": "div",
                                "attrs": {
                                  "class": "table-actions"
                                },
                                "children": [
                                  {
                                    "component": "ui/modal-trigger",
                                    "data": {
                                      "class": "btn btn-sm btn-ghost btn-icon",
                                      "modal": {
                                        "concat": [
                                          "report-detail-",
                                          {
                                            "get": "report.id"
                                          }
                                        ]
                                      },
                                      "url": {
                                        "concat": [
                                          "/api/moderation/reports/",
                                          {
                                            "get": "report.id"
                                          },
                                          ""
                                        ]
                                      },
                                      "label": {
                                        "t": "moderation.detail"
                                      },
                                      "icon": "eye",
                                      "icon_only": true
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "when": {
          "get": "items"
        }
      },
      {
        "component": "ui/pagination",
        "data": {
          "navigation": {
            "get": "navigation"
          },
          "target": "#moderation-reports"
        }
      }
    ]
  },
  "moderation/filter-form": {
    "tag": "form",
    "attrs": {
      "class": "stack",
      "method": "get",
      "action": "/api/moderation/reports",
      "data-api-method": "GET",
      "data-ajax-form": "",
      "data-ajax-target": "#moderation-reports",
      "data-history": "/admin/moderation/reports"
    },
    "children": [
      {
        "each": {
          "get": "filters"
        },
        "as": "value",
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": {
                "get": "_key"
              },
              "value": {
                "get": "value"
              }
            },
            "children": [],
            "when": {
              "and": [
                {
                  "not": {
                    "eq": [
                      {
                        "get": "_key"
                      },
                      "status"
                    ]
                  }
                },
                {
                  "not": {
                    "eq": [
                      {
                        "get": "_key"
                      },
                      "reason"
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "component": "ui/select",
        "data": {
          "label": {
            "t": "common.status"
          },
          "choices": {
            "": {
              "t": "common.all"
            },
            "open": {
              "t": "moderation.report_statuses.open"
            },
            "reviewed": {
              "t": "moderation.report_statuses.reviewed"
            },
            "resolved": {
              "t": "moderation.report_statuses.resolved"
            },
            "dismissed": {
              "t": "moderation.report_statuses.dismissed"
            }
          },
          "value": {
            "get": "filters.status"
          },
          "attributes": {
            "class": "select",
            "name": "status"
          }
        }
      },
      {
        "component": "ui/select",
        "data": {
          "label": {
            "t": "moderation.report_reason"
          },
          "choices": {
            "": {
              "t": "common.all"
            },
            "spam": {
              "t": "moderation.report_reasons.spam"
            },
            "illegal": {
              "t": "moderation.report_reasons.illegal"
            },
            "malware": {
              "t": "moderation.report_reasons.malware"
            },
            "abuse": {
              "t": "moderation.report_reasons.abuse"
            },
            "other": {
              "t": "moderation.report_reasons.other"
            }
          },
          "value": {
            "get": "filters.reason"
          },
          "attributes": {
            "class": "select",
            "name": "reason"
          }
        }
      }
    ]
  },
