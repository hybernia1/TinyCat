            }
          }
        ]
      },
      {
        "tag": "dt",
        "attrs": {
          "class": "text-muted"
        },
        "children": [
          {
            "t": "common.status"
          }
        ]
      },
      {
        "tag": "dd",
        "attrs": {
          "class": "m-0 is-resource-text"
        },
        "children": [
          {
            "component": "moderation/status",
            "data": {
              "status": {
                "get": "report.status"
              }
            }
          }
