                            "t": "common.actions",
                            "values": {}
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "tbody",
                "attrs": {},
                "children": [
                  {
                    "each": {
                      "get": "items"
                    },
                    "as": "report",
                    "children": [
                      {
                        "tag": "tr",
                        "attrs": {},
                        "children": [
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-identity"
                                },
                                "children": [
                                  {
                                    "tag": "div",
                                    "attrs": {
                                      "class": "table-identity-body"
                                    },
                                    "children": [
                                      {
                                        "tag": "strong",
                                        "attrs": {
                                          "class": "table-primary",
                                          "title": {
                                            "or": [
                                              {
                                                "get": "report.excerpt"
                                              },
                                              {
                                                "t": "moderation.empty_content"
                                              }
                                            ]
                                          }
                                        },
                                        "children": [
                                          {
                                            "or": [
                                              {
                                                "get": "report.excerpt"
                                              },
                                              {
                                                "t": "moderation.empty_content"
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "div",
                                        "attrs": {
                                          "class": "table-meta",
                                          "title": {
                                            "concat": [
                                              "#",
                                              {
                                                "get": "report.content_id"
                                              },
                                              " · ",
                                              {
                                                "get": "report.author_name"
                                              }
                                            ]
                                          }
                                        },
                                        "children": [
                                          {
                                            "concat": [
                                              "#",
                                              {
                                                "get": "report.content_id"
                                              },
                                              " · ",
                                              {
                                                "get": "report.author_name"
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "div",
                                        "attrs": {
                                          "class": "table-meta",
                                          "title": {
                                            "plural": "moderation.report_count",
                                            "count": {
                                              "get": "report.report_count"
                                            }
                                          }
                                        },
                                        "children": [
                                          {
                                            "plural": "moderation.report_count",
                                            "count": {
                                              "get": "report.report_count"
                                            }
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "lookup": {
                                  "get": "report.reason"
                                },
                                "cases": {
                                  "spam": {
                                    "t": "moderation.report_reasons.spam"
                                  },
                                  "illegal": {
                                    "t": "moderation.report_reasons.illegal"
                                  },
                                  "malware": {
                                    "t": "moderation.report_reasons.malware"
                                  },
                                  "abuse": {
                                    "t": "moderation.report_reasons.abuse"
                                  },
                                  "other": {
                                    "t": "moderation.report_reasons.other"
                                  }
                                },
                                "default": {
                                  "t": "moderation.report_reasons.other"
                                }
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "component": "moderation/status",
                                "data": {
                                  "status": {
                                    "get": "report.status"
                                  }
                                }
                              },
                              {
