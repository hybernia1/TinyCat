        "children": [
          {
            "or": [
              {
                "get": "report.reporter_name"
              },
              "—"
            ]
          }
        ]
      },
      {
        "tag": "dt",
        "attrs": {
          "class": "text-muted"
        },
        "children": [
          {
            "t": "moderation.report_reason"
