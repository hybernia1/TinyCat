{
  "moderation/reports": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-14"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-info"
        },
        "children": [
          {
            "t": "moderation.reports_empty",
            "values": {}
          }
        ],
        "when": {
          "not": {
            "get": "items"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "table-wrap"
        },
        "children": [
          {
            "tag": "table",
            "attrs": {
              "class": "table"
            },
            "children": [
              {
                "tag": "thead",
                "attrs": {},
                "children": [
                  {
                    "tag": "tr",
                    "attrs": {},
                    "children": [
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.content.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "moderation.reported_content",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.content"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.reason.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "moderation.report_reason",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.reason"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.status.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "common.status",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.status"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "class": "table-actions-cell",
                          "scope": "col"
                        },
                        "children": [
                          {
                            "t": "common.actions",
                            "values": {}
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "tbody",
                "attrs": {},
                "children": [
                  {
                    "each": {
                      "get": "items"
                    },
                    "as": "report",
                    "children": [
                      {
                        "tag": "tr",
                        "attrs": {},
                        "children": [
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "strong",
                                "attrs": {},
                                "children": [
                                  {
                                    "or": [
                                      {
                                        "get": "report.excerpt"
                                      },
                                      {
                                        "t": "moderation.empty_content"
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-meta"
                                },
                                "children": [
                                  {
                                    "concat": [
                                      "#",
                                      {
                                        "get": "report.content_id"
                                      },
                                      " · @",
                                      {
                                        "get": "report.author_name"
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-meta"
                                },
                                "children": [
                                  {
                                    "plural": "moderation.report_count",
                                    "count": {
                                      "get": "report.report_count"
                                    }
                                  }
                                ]
                              },
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-meta"
                                },
                                "children": [
                                  {
                                    "get": "report.note"
                                  }
                                ],
                                "when": {
                                  "get": "report.note"
                                }
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "lookup": {
                                  "get": "report.reason"
                                },
                                "cases": {
                                  "spam": {
                                    "t": "moderation.report_reasons.spam"
                                  },
                                  "illegal": {
                                    "t": "moderation.report_reasons.illegal"
                                  },
                                  "malware": {
                                    "t": "moderation.report_reasons.malware"
                                  },
                                  "abuse": {
                                    "t": "moderation.report_reasons.abuse"
                                  },
                                  "other": {
                                    "t": "moderation.report_reasons.other"
                                  }
                                },
                                "default": {
                                  "t": "moderation.report_reasons.other"
                                }
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "span",
                                "attrs": {
                                  "class": {
                                    "concat": [
                                      "badge",
                                      {
                                        "if": [
                                          {
                                            "eq": [
                                              {
                                                "get": "report.status"
                                              },
                                              "open"
                                            ]
                                          },
                                          " badge-primary",
                                          ""
                                        ]
                                      }
                                    ]
                                  }
                                },
                                "children": [
                                  {
                                    "lookup": {
                                      "get": "report.status"
                                    },
                                    "cases": {
                                      "open": {
                                        "t": "moderation.report_statuses.open"
                                      },
                                      "resolved": {
                                        "t": "moderation.report_statuses.resolved"
                                      },
                                      "dismissed": {
                                        "t": "moderation.report_statuses.dismissed"
                                      },
                                      "reviewed": {
                                        "t": "moderation.report_statuses.reviewed"
                                      }
                                    },
                                    "default": {
                                      "t": "moderation.report_statuses.reviewed"
                                    }
                                  }
                                ]
                              },
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-meta"
                                },
                                "children": [
                                  {
                                    "date": {
                                      "get": "report.reported_at"
                                    }
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {
                              "class": "table-actions-cell"
                            },
                            "children": [
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-actions"
                                },
                                "children": [
                                  {
                                    "tag": "a",
                                    "attrs": {
                                      "class": "btn btn-sm btn-ghost btn-icon",
                                      "href": {
                                        "get": "report.permalink_url"
                                      },
                                      "aria-label": {
                                        "use": "status/permalink",
                                        "data": {
                                          "item": {
                                            "get": "report"
                                          }
                                        }
                                      }
                                    },
                                    "children": [
                                      {
                                        "icon": "link"
                                      }
                                    ],
                                    "when": {
                                      "get": "report.permalink_url"
                                    }
                                  },
                                  {
                                    "component": "ui/api-action",
                                    "data": {
                                      "url": {
                                        "concat": [
                                          "/api/moderation/reports/",
                                          {
                                            "get": "report.id"
                                          }
                                        ]
                                      },
                                      "method": "PATCH",
                                      "target": "#moderation-reports",
                                      "fields": {
                                        "decision": "remove"
                                      },
                                      "label": {
                                        "t": "moderation.remove_content",
                                        "values": {}
                                      },
                                      "confirm": {
                                        "t": "account.status_delete_confirm",
                                        "values": {}
                                      },
                                      "icon": "trash",
                                      "button_class": "btn btn-sm btn-ghost btn-icon text-danger"
                                    },
                                    "when": {
                                      "get": "report.open_count"
                                    }
                                  },
                                  {
                                    "component": "ui/api-action",
                                    "data": {
                                      "url": {
                                        "concat": [
                                          "/api/moderation/reports/",
                                          {
                                            "get": "report.id"
                                          }
                                        ]
                                      },
                                      "method": "PATCH",
                                      "target": "#moderation-reports",
                                      "fields": {
                                        "decision": "dismiss"
                                      },
                                      "label": {
                                        "t": "moderation.keep_and_lock",
                                        "values": {}
                                      },
                                      "icon": "shield-check",
                                      "button_class": "btn btn-sm btn-ghost btn-icon"
                                    },
                                    "when": {
                                      "get": "report.open_count"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "when": {
          "get": "items"
        }
      }
    ]
  }
}
