{
  "moderation/reports": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-14",
      "data-moderation-reports-view": "",
      "data-moderation-reports-state": {
        "json": {
          "get": "state"
        }
      }
    },
    "children": [
      {
        "component": "ui/list-toolbar",
        "data": {
          "url": "/api/moderation/reports",
          "target": "#moderation-reports",
          "history": "/admin/moderation/reports",
          "filters": {
            "get": "filters"
          },
          "pagination": {
            "get": "pagination"
          },
          "filter_modal": "moderation-filter-modal"
        },
        "when": {
          "get": "filters"
        }
      },
      {
        "component": "ui/empty-state",
        "when": {
          "not": {
            "get": "items"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "table-wrap"
        },
        "children": [
          {
            "tag": "table",
            "attrs": {
              "class": "table"
            },
            "children": [
              {
                "tag": "thead",
                "attrs": {},
                "children": [
                  {
                    "tag": "tr",
                    "attrs": {},
                    "children": [
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.content.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "moderation.reported_content",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.content"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.reason.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "moderation.report_reason",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.reason"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "scope": "col",
                          "aria-sort": {
                            "get": "sorting.status.aria"
                          }
                        },
                        "children": [
                          {
                            "component": "ui/sort-heading",
                            "data": {
                              "label": {
                                "t": "common.status",
                                "values": {}
                              },
                              "order": {
                                "get": "sorting.status"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {
                          "class": "table-actions-cell",
                          "scope": "col"
                        },
                        "children": [
                          {
                            "t": "common.actions",
                            "values": {}
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "tbody",
                "attrs": {},
                "children": [
                  {
                    "each": {
                      "get": "items"
                    },
                    "as": "report",
                    "children": [
                      {
                        "tag": "tr",
                        "attrs": {},
                        "children": [
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-identity"
                                },
                                "children": [
                                  {
                                    "tag": "div",
                                    "attrs": {
                                      "class": "table-identity-body"
                                    },
                                    "children": [
                                      {
                                        "tag": "strong",
                                        "attrs": {
                                          "class": "table-primary",
                                          "title": {
                                            "or": [
                                              {
                                                "get": "report.excerpt"
                                              },
                                              {
                                                "t": "moderation.empty_content"
                                              }
                                            ]
                                          }
                                        },
                                        "children": [
                                          {
                                            "or": [
                                              {
                                                "get": "report.excerpt"
                                              },
                                              {
                                                "t": "moderation.empty_content"
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "div",
                                        "attrs": {
                                          "class": "table-meta",
                                          "title": {
                                            "concat": [
                                              "#",
                                              {
                                                "get": "report.content_id"
                                              },
                                              " · ",
                                              {
                                                "get": "report.author_name"
                                              }
                                            ]
                                          }
                                        },
                                        "children": [
                                          {
                                            "concat": [
                                              "#",
                                              {
                                                "get": "report.content_id"
                                              },
                                              " · ",
                                              {
                                                "get": "report.author_name"
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "div",
                                        "attrs": {
                                          "class": "table-meta",
                                          "title": {
                                            "plural": "moderation.report_count",
                                            "count": {
                                              "get": "report.report_count"
                                            }
                                          }
                                        },
                                        "children": [
                                          {
                                            "plural": "moderation.report_count",
                                            "count": {
                                              "get": "report.report_count"
                                            }
                                          }
                                        ]
                                      },
                                      {
                                        "tag": "div",
                                        "attrs": {
                                          "class": "table-meta",
                                          "title": {
                                            "get": "report.note"
                                          }
                                        },
                                        "children": [
                                          {
                                            "get": "report.note"
                                          }
                                        ],
                                        "when": {
                                          "get": "report.note"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "lookup": {
                                  "get": "report.reason"
                                },
                                "cases": {
                                  "spam": {
                                    "t": "moderation.report_reasons.spam"
                                  },
                                  "illegal": {
                                    "t": "moderation.report_reasons.illegal"
                                  },
                                  "malware": {
                                    "t": "moderation.report_reasons.malware"
                                  },
                                  "abuse": {
                                    "t": "moderation.report_reasons.abuse"
                                  },
                                  "other": {
                                    "t": "moderation.report_reasons.other"
                                  }
                                },
                                "default": {
                                  "t": "moderation.report_reasons.other"
                                }
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "span",
                                "attrs": {
                                  "class": {
                                    "concat": [
                                      "badge",
                                      {
                                        "if": [
                                          {
                                            "eq": [
                                              {
                                                "get": "report.status"
                                              },
                                              "open"
                                            ]
                                          },
                                          " badge-primary",
                                          ""
                                        ]
                                      }
                                    ]
                                  }
                                },
                                "children": [
                                  {
                                    "lookup": {
                                      "get": "report.status"
                                    },
                                    "cases": {
                                      "open": {
                                        "t": "moderation.report_statuses.open"
                                      },
                                      "resolved": {
                                        "t": "moderation.report_statuses.resolved"
                                      },
                                      "dismissed": {
                                        "t": "moderation.report_statuses.dismissed"
                                      },
                                      "reviewed": {
                                        "t": "moderation.report_statuses.reviewed"
                                      }
                                    },
                                    "default": {
                                      "t": "moderation.report_statuses.reviewed"
                                    }
                                  }
                                ]
                              },
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-meta"
                                },
                                "children": [
                                  {
                                    "date": {
                                      "get": "report.reported_at"
                                    }
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {
                              "class": "table-actions-cell"
                            },
                            "children": [
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-actions"
                                },
                                "children": [
                                  {
                                    "tag": "a",
                                    "attrs": {
                                      "class": "btn btn-sm btn-ghost btn-icon",
                                      "href": {
                                        "get": "report.permalink_url"
                                      },
                                      "aria-label": {
                                        "use": "status/permalink",
                                        "data": {
                                          "item": {
                                            "get": "report"
                                          }
                                        }
                                      }
                                    },
                                    "children": [
                                      {
                                        "icon": "link"
                                      }
                                    ],
                                    "when": {
                                      "get": "report.permalink_url"
                                    }
                                  },
                                  {
                                    "component": "ui/api-action",
                                    "data": {
                                      "url": {
                                        "or": [
                                          {
                                            "get": "report.action_url"
                                          },
                                          {
                                            "concat": [
                                              "/api/moderation/reports/",
                                              {
                                                "get": "report.id"
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      "method": "PATCH",
                                      "target": "#moderation-reports",
                                      "fields": {
                                        "decision": "remove"
                                      },
                                      "label": {
                                        "t": "moderation.remove_content",
                                        "values": {}
                                      },
                                      "confirm": {
                                        "t": "account.status_delete_confirm",
                                        "values": {}
                                      },
                                      "icon": "trash",
                                      "button_class": "btn btn-sm btn-ghost btn-icon text-danger"
                                    },
                                    "when": {
                                      "get": "report.open_count"
                                    }
                                  },
                                  {
                                    "component": "ui/api-action",
                                    "data": {
                                      "url": {
                                        "or": [
                                          {
                                            "get": "report.action_url"
                                          },
                                          {
                                            "concat": [
                                              "/api/moderation/reports/",
                                              {
                                                "get": "report.id"
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      "method": "PATCH",
                                      "target": "#moderation-reports",
                                      "fields": {
                                        "decision": "dismiss"
                                      },
                                      "label": {
                                        "t": "moderation.keep_and_lock",
                                        "values": {}
                                      },
                                      "icon": "shield-check",
                                      "button_class": "btn btn-sm btn-ghost btn-icon"
                                    },
                                    "when": {
                                      "get": "report.open_count"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "when": {
          "get": "items"
        }
      },
      {
        "component": "ui/pagination",
        "data": {
          "navigation": {
            "get": "navigation"
          },
          "target": "#moderation-reports"
        }
      }
    ]
  },
  "moderation/filter-form": {
    "tag": "form",
    "attrs": {
      "class": "stack",
      "method": "get",
      "action": "/api/moderation/reports",
      "data-api-method": "GET",
      "data-ajax-form": "",
      "data-ajax-target": "#moderation-reports",
      "data-history": "/admin/moderation/reports"
    },
    "children": [
      {
        "each": {
          "get": "filters"
        },
        "as": "value",
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": {
                "get": "_key"
              },
              "value": {
                "get": "value"
              }
            },
            "children": [],
            "when": {
              "and": [
                {
                  "not": {
                    "eq": [
                      {
                        "get": "_key"
                      },
                      "status"
                    ]
                  }
                },
                {
                  "not": {
                    "eq": [
                      {
                        "get": "_key"
                      },
                      "reason"
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "component": "ui/select",
        "data": {
          "label": {
            "t": "common.status"
          },
          "choices": {
            "": {
              "t": "common.all"
            },
            "open": {
              "t": "moderation.report_statuses.open"
            },
            "reviewed": {
              "t": "moderation.report_statuses.reviewed"
            },
            "resolved": {
              "t": "moderation.report_statuses.resolved"
            },
            "dismissed": {
              "t": "moderation.report_statuses.dismissed"
            }
          },
          "value": {
            "get": "filters.status"
          },
          "attributes": {
            "class": "select",
            "name": "status"
          }
        }
      },
      {
        "component": "ui/select",
        "data": {
          "label": {
            "t": "moderation.report_reason"
          },
          "choices": {
            "": {
              "t": "common.all"
            },
            "spam": {
              "t": "moderation.report_reasons.spam"
            },
            "illegal": {
              "t": "moderation.report_reasons.illegal"
            },
            "malware": {
              "t": "moderation.report_reasons.malware"
            },
            "abuse": {
              "t": "moderation.report_reasons.abuse"
            },
            "other": {
              "t": "moderation.report_reasons.other"
            }
          },
          "value": {
            "get": "filters.reason"
          },
          "attributes": {
            "class": "select",
            "name": "reason"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "cluster gap-2"
        },
        "children": [
          {
            "tag": "a",
            "attrs": {
              "href": "/api/moderation/reports",
              "data-ajax": "",
              "data-ajax-target": "#moderation-reports",
              "data-history": "/admin/moderation/reports",
              "class": "btn btn-ghost btn-sm"
            },
            "children": [
              {
                "icon": "close"
              },
              {
                "tag": "span",
                "children": [
                  {
                    "t": "common.clear_filters"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
