  "moderation/status": {
    "component": "ui/status-badge",
    "data": {
      "tone": {
        "lookup": {
          "get": "status"
        },
        "cases": {
          "open": "primary",
          "resolved": "ok",
          "dismissed": "ok",
          "reviewed": "ok"
        },
        "default": "unknown"
      },
      "label": {
        "lookup": {
          "get": "status"
        },
        "cases": {
          "open": {
            "t": "moderation.report_statuses.open"
          },
          "resolved": {
            "t": "moderation.report_statuses.resolved"
          },
          "dismissed": {
            "t": "moderation.report_statuses.dismissed"
          },
          "reviewed": {
            "t": "moderation.report_statuses.reviewed"
          }
        },
        "default": {
          "t": "moderation.report_statuses.reviewed"
        }
      }
    }
  }
}
