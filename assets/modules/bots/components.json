                        "count": {
                          "get": "items"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "tag": "span",
                "attrs": {
                  "class": "badge badge-primary"
                },
                "children": [
                  {
                    "t": "bots.active_sources_count",
                    "values": {
                      "count": {
                        "count": {
                          "get": "items"
                        },
                        "where": "enabled"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-info"
        },
        "children": [
          {
            "t": "bots.no_sources",
            "values": {}
          }
        ],
        "when": {
          "not": {
            "get": "items"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "table-wrap"
        },
        "children": [
          {
            "tag": "table",
            "attrs": {
              "class": "table"
            },
            "children": [
              {
                "tag": "thead",
                "attrs": {},
                "children": [
                  {
                    "tag": "tr",
                    "attrs": {},
                    "children": [
                      {
                        "tag": "th",
                        "attrs": {},
                        "children": [
                          {
                            "t": "bots.source_name",
                            "values": {}
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {},
                        "children": [
                          {
                            "t": "bots.bot",
                            "values": {}
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {},
                        "children": [
                          {
                            "t": "common.status",
                            "values": {}
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {},
                        "children": [
                          {
                            "t": "bots.schedule",
                            "values": {}
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {},
                        "children": [
                          {
                            "t": "bots.last_import",
                            "values": {}
                          }
                        ]
                      },
                      {
                        "tag": "th",
                        "attrs": {},
                        "children": [
                          {
                            "t": "common.actions",
                            "values": {}
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "tbody",
                "attrs": {},
                "children": [
                  {
                    "each": {
                      "get": "items"
                    },
                    "as": "source",
                    "children": [
                      {
                        "tag": "tr",
                        "attrs": {},
                        "children": [
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "strong",
                                "attrs": {},
                                "children": [
                                  {
                                    "get": "source.name"
                                  }
                                ]
                              },
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-meta"
                                },
                                "children": [
                                  {
                                    "tag": "a",
                                    "attrs": {
                                      "href": {
                                        "get": "source.feed_url"
                                      },
                                      "target": "_blank",
                                      "rel": "noopener noreferrer"
                                    },
                                    "children": [
                                      {
                                        "get": "source.feed_url"
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-meta text-danger"
                                },
                                "children": [
                                  {
                                    "get": "source.last_error"
                                  }
                                ],
                                "when": {
                                  "get": "source.last_error"
                                }
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "a",
                                "attrs": {
                                  "href": {
                                    "concat": [
                                      "/admin/bots/",
                                      {
                                        "get": "source.bot_user_id"
                                      }
                                    ]
                                  }
                                },
                                "children": [
                                  {
                                    "concat": [
                                      "@",
                                      {
                                        "get": "source.bot_username"
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "span",
                                "attrs": {
                                  "class": {
                                    "concat": [
                                      "badge",
                                      {
                                        "if": [
                                          {
                                            "get": "source.enabled"
                                          },
                                          " badge-primary",
                                          ""
                                        ]
                                      }
                                    ]
                                  }
                                },
                                "children": [
                                  {
                                    "if": [
                                      {
                                        "get": "source.enabled"
                                      },
                                      {
                                        "t": "bots.enabled",
                                        "values": {}
                                      },
                                      {
                                        "t": "bots.disabled",
                                        "values": {}
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "t": "bots.every_minutes",
                                "values": {
                                  "count": {
                                    "get": "source.interval_minutes"
                                  }
                                }
                              },
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-meta"
                                },
                                "children": [
                                  {
                                    "get": "source.next_run_label"
                                  }
                                ],
                                "when": {
                                  "get": "source.next_run_at"
                                }
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {
                              "class": "table-meta"
                            },
                            "children": [
                              {
                                "or": [
                                  {
                                    "get": "source.last_imported_label"
                                  },
                                  {
                                    "t": "bots.never_imported",
                                    "values": {}
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "tag": "td",
                            "attrs": {},
                            "children": [
                              {
                                "tag": "div",
                                "attrs": {
                                  "class": "table-actions"
                                },
                                "children": [
                                  {
                                    "tag": "button",
                                    "attrs": {
                                      "class": "btn btn-sm btn-ghost btn-icon",
                                      "type": "button",
                                      "data-bot-source-edit": {
                                        "get": "source.id"
                                      },
                                      "aria-label": {
                                        "t": "bots.edit_source"
                                      },
                                      "title": {
                                        "t": "bots.edit_source"
                                      }
                                    },
                                    "children": [
                                      {
                                        "icon": "edit"
                                      }
                                    ]
                                  },
                                  {
                                    "component": "ui/api-action",
                                    "data": {
                                      "url": {
                                        "concat": [
                                          "/api/bots/sources/",
                                          {
                                            "get": "source.id"
                                          }
                                        ]
                                      },
                                      "method": "PATCH",
                                      "target": "#bots-list",
                                      "fields": {
                                        "enabled": {
                                          "if": [
                                            {
                                              "get": "source.enabled"
                                            },
                                            "0",
                                            "1"
                                          ]
                                        }
                                      },
                                      "label": {
                                        "if": [
                                          {
                                            "get": "source.enabled"
                                          },
                                          {
                                            "t": "bots.detail_pause",
                                            "values": {}
                                          },
                                          {
                                            "t": "bots.detail_enable",
                                            "values": {}
                                          }
                                        ]
                                      },
                                      "icon": {
                                        "if": [
                                          {
                                            "get": "source.enabled"
                                          },
                                          "pause",
                                          "play"
                                        ]
                                      },
                                      "button_class": "btn btn-sm btn-ghost btn-icon"
                                    }
                                  },
                                  {
                                    "component": "ui/api-action",
                                    "data": {
                                      "url": {
                                        "concat": [
                                          "/api/bots/sources/",
                                          {
                                            "get": "source.id"
                                          },
                                          "/runs"
                                        ]
                                      },
                                      "method": "POST",
                                      "target": "#bots-list",
                                      "label": {
                                        "t": "bots.detail_run_now",
                                        "values": {}
                                      },
                                      "icon": "refresh",
                                      "button_class": "btn btn-sm btn-ghost btn-icon"
                                    }
                                  },
                                  {
                                    "component": "ui/api-action",
                                    "data": {
                                      "url": {
                                        "concat": [
                                          "/api/bots/sources/",
                                          {
                                            "get": "source.id"
                                          }
                                        ]
                                      },
                                      "method": "DELETE",
                                      "target": "#bots-list",
                                      "label": {
                                        "t": "common.delete",
                                        "values": {}
                                      },
                                      "confirm": {
                                        "t": "bots.delete_confirm",
                                        "values": {}
                                      },
                                      "icon": "trash",
                                      "button_class": "btn btn-sm btn-ghost btn-icon text-danger"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "when": {
          "get": "items"
        }
      }
    ]
  },
