{
  "bots/source-fields": {
    "tag": "div",
    "attrs": {
      "class": "stack"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "grid sm:grid-2"
        },
        "children": [
          {
            "tag": "label",
            "attrs": {
              "class": "field"
            },
            "children": [
              {
                "tag": "span",
                "attrs": {
                  "class": "label"
                },
                "children": [
                  {
                    "t": "bots.bot",
                    "values": {}
                  }
                ]
              },
              {
                "tag": "select",
                "attrs": {
                  "class": "select",
                  "name": "bot_user_id",
                  "required": true
                },
                "children": [
                  {
                    "each": {
                      "get": "bots"
                    },
                    "as": "bot",
                    "children": [
                      {
                        "tag": "option",
                        "attrs": {
                          "value": {
                            "get": "bot.id"
                          },
                          "selected": {
                            "if": [
                              {
                                "eq": [
                                  {
                                    "string": {
                                      "get": "bot.id"
                                    }
                                  },
                                  {
                                    "string": {
                                      "get": "source.bot_user_id"
                                    }
                                  }
                                ]
                              },
                              true,
                              null
                            ]
                          }
                        },
                        "children": [
                          {
                            "concat": [
                              "@",
                              {
                                "get": "bot.username"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "component": "ui/field",
            "data": {
              "label": {
                "t": "bots.source_name",
                "values": {}
              },
              "value": {
                "get": "source.name"
              },
              "textarea": false,
              "attributes": {
                "class": "input",
                "name": "name",
                "type": "text",
                "value": {
                  "get": "source.name"
                },
                "required": true,
                "maxlength": "120"
              }
            }
          }
        ]
      },
      {
        "component": "ui/field",
        "data": {
          "label": {
            "t": "bots.feed_url",
            "values": {}
          },
          "value": {
            "get": "source.feed_url"
          },
          "textarea": false,
          "attributes": {
            "class": "input",
            "name": "feed_url",
            "type": "url",
            "value": {
              "get": "source.feed_url"
            },
            "required": true,
            "maxlength": "2048"
          }
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {
            "t": "bots.interval",
            "values": {}
          },
          "value": {
            "or": [
              {
                "get": "source.interval_minutes"
              },
              60
            ]
          },
          "textarea": false,
          "attributes": {
            "class": "input",
            "name": "interval_minutes",
            "type": "number",
            "value": {
              "or": [
                {
                  "get": "source.interval_minutes"
                },
                60
              ]
            },
            "required": true,
            "min": "5",
            "max": "43200"
          }
        }
      },
      {
        "component": "ui/field",
        "data": {
          "label": {
            "t": "bots.template",
            "values": {}
          },
          "value": {
            "get": "source.post_template"
          },
          "textarea": true,
          "attributes": {
            "class": "textarea",
            "name": "post_template",
            "required": true,
            "maxlength": "2000",
            "rows": "8"
          }
        }
      },
      {
        "tag": "label",
        "attrs": {
          "class": "check"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": "enabled",
              "value": "0"
            },
            "children": []
          },
          {
            "tag": "input",
            "attrs": {
              "type": "checkbox",
              "name": "enabled",
              "value": "1",
              "checked": {
                "if": [
                  {
                    "get": "source.enabled"
                  },
                  true,
                  null
                ]
              }
            },
            "children": []
          },
          {
            "tag": "span",
            "attrs": {},
            "children": [
              {
                "t": "bots.enabled",
                "values": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "bots/sources": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-14",
      "data-bot-sources-view": "",
      "data-bot-sources-state": {
        "json": {
          "get": "state"
        }
      }
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "admin-list-toolbar"
        },
        "children": [
          {
            "tag": "div",
