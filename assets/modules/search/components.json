{
  "search/page": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-16"
    },
    "children": [
      {
        "tag": "header",
        "attrs": {
          "class": "public-list-header"
        },
        "children": [
          {
            "tag": "h1",
            "attrs": {
              "class": "text-2xl m-0"
            },
            "children": [
              {
                "if": [
                  {
                    "get": "search.valid"
                  },
                  {
                    "t": "public.search_title_query",
                    "values": {
                      "query": {
                        "get": "search.query"
                      }
                    }
                  },
                  {
                    "t": "public.search_title",
                    "values": {}
                  }
                ]
              }
            ]
          },
          {
            "component": "site/archive-actions",
            "data": {
              "rss_url": {
                "get": "rss_url"
              },
              "archive_options": {
                "get": "archive_options"
              },
              "archive_type": {
                "get": "archive_type"
              }
            },
            "when": {
              "get": "search.valid"
            }
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-info"
        },
        "children": [
          {
            "t": "public.search_length",
            "values": {
              "min": {
                "get": "search.minimum_length"
              },
              "max": 80
            }
          }
        ],
        "when": {
          "not": {
            "get": "search.valid"
          }
        }
      },
      {
        "tag": "form",
        "attrs": {
          "class": "card",
          "action": "/api/security/challenges/search",
          "data-ajax-form": "",
          "method": "post"
        },
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": "_csrf",
              "value": {
                "get": "csrf"
              }
            },
            "children": []
          },
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": "next",
              "value": {
                "get": "url"
              }
            },
            "children": []
          },
          {
            "tag": "div",
            "attrs": {
              "class": "card-header"
            },
            "children": [
              {
                "tag": "strong",
                "attrs": {},
                "children": [
                  {
                    "t": "public.search_captcha_title",
                    "values": {}
                  }
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "card-body stack stack-gap-12"
            },
            "children": [
              {
                "tag": "p",
                "attrs": {
                  "class": "muted m-0"
                },
                "children": [
                  {
                    "t": "public.search_captcha_required",
                    "values": {}
                  }
                ]
              },
              {
                "component": "ui/captcha",
                "data": {
                  "config": {
                    "get": "search.captcha"
                  }
                }
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "card-footer justify-end"
            },
            "children": [
              {
                "tag": "a",
                "attrs": {
                  "class": "btn btn-ghost",
                  "href": {
                    "get": "login_url"
                  },
                  "data-modal-open": "auth-modal",
                  "data-modal-url": {
                    "get": "login_modal_url"
                  }
                },
                "children": [
                  {
                    "t": "auth.login_title",
                    "values": {}
                  }
                ]
              },
              {
                "tag": "button",
                "attrs": {
                  "class": "btn btn-primary",
                  "type": "submit"
                },
                "children": [
                  {
                    "t": "common.confirm",
                    "values": {}
                  }
                ]
              }
            ]
          }
        ],
        "when": {
          "and": [
            {
              "get": "search.blocked"
            },
            {
              "eq": [
                {
                  "get": "search.block_code"
                },
                "captcha_required"
              ]
            }
          ]
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "alert alert-info"
        },
        "children": [
          {
            "t": "moderation.messages.action_limited",
            "values": {}
          }
        ],
        "when": {
          "and": [
            {
              "get": "search.blocked"
            },
            {
              "not": {
                "eq": [
                  {
                    "get": "search.block_code"
                  },
                  "captcha_required"
                ]
              }
            }
          ]
        }
      },
      {
        "component": "ui/empty-state",
        "data": {
          "label": {
            "t": "public.search_empty",
            "values": {}
          },
          "icon": "search"
        },
        "when": {
          "and": [
            {
              "and": [
                {
                  "get": "search.valid"
                },
                {
                  "not": {
                    "get": "search.blocked"
                  }
                }
              ]
            },
            {
              "get": "search.empty"
            }
          ]
        }
      },
      {
        "tag": "div",
        "attrs": {
          "id": "search-results",
          "class": "status-feed"
        },
        "children": [
          {
            "each": {
              "get": "items"
            },
            "as": "post",
            "children": [
              {
                "component": "status/card",
                "data": {
                  "item": {
                    "get": "post"
                  },
                  "anchor": true,
                  "open_modal": true,
                  "action": {
                    "get": "url"
                  }
                }
              }
            ]
          }
        ],
        "when": {
          "and": [
            {
              "and": [
                {
                  "get": "search.valid"
                },
                {
                  "not": {
                    "get": "search.blocked"
                  }
                }
              ]
            },
            {
              "not": {
                "get": "search.empty"
              }
            }
          ]
        }
      },
      {
        "component": "status/feed-more",
        "data": {
          "target": "#search-results",
          "url": {
            "get": "next_url"
          }
        },
        "when": {
          "and": [
            {
              "get": "search.valid"
            },
            {
              "not": {
                "get": "search.blocked"
              }
            }
          ]
        }
      }
    ]
  }
}
