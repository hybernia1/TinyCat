          null
        ]
      },
      "title": {
        "if": [
          {
            "lookup": {
              "get": "tone"
            },
            "cases": {
              "ok": true,
              "success": true,
              "critical": true,
              "danger": true,
              "warning": true
            },
            "default": false
          },
          {
            "get": "label"
          },
          null
