{
  "ui/field": {
    "tag": "label",
    "attrs": {
      "class": "field"
    },
    "children": [
      {
        "tag": "span",
        "attrs": {
          "class": "label"
        },
        "children": [
          {
            "get": "label"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "get": "attributes"
        },
        "children": [],
        "when": {
          "not": {
            "get": "textarea"
          }
        }
      },
      {
        "tag": "textarea",
        "attrs": {
          "get": "attributes"
        },
        "children": [
          {
            "get": "value"
          }
        ],
        "when": {
          "get": "textarea"
        }
      }
    ]
  },
  "ui/select": {
    "tag": "label",
    "attrs": {
      "class": "field"
    },
    "children": [
      {
        "tag": "span",
        "attrs": {
          "class": "label"
        },
        "children": [
          {
            "get": "label"
          }
        ]
      },
      {
        "tag": "select",
        "attrs": {
          "get": "attributes"
        },
        "children": [
          {
            "each": {
              "get": "choices"
            },
            "as": "choice",
            "children": [
              {
                "tag": "option",
                "attrs": {
                  "value": {
                    "get": "_key"
                  },
                  "selected": {
                    "if": [
                      {
                        "eq": [
                          {
                            "string": {
                              "get": "_key"
                            }
                          },
                          {
                            "string": {
                              "get": "value"
                            }
                          }
                        ]
                      },
                      true,
                      null
                    ]
                  }
                },
                "children": [
                  {
                    "get": "choice"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "ui/pagination": {
    "tag": "nav",
    "attrs": {
      "class": "pagination",
      "aria-label": {
        "t": "common.pagination"
      }
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "pagination-summary"
        },
        "children": [
          {
            "t": "common.pagination_summary",
            "values": {
              "from": {
                "get": "navigation.from"
              },
              "to": {
                "get": "navigation.to"
              },
              "total": {
                "get": "navigation.total"
              }
            }
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "pagination-list"
        },
        "children": [
          {
            "component": "ui/pagination-step",
            "data": {
              "step": {
                "get": "navigation.previous"
              },
              "kind": "prev",
              "icon": "chevron-left",
              "label": {
                "t": "common.previous"
              },
              "target": {
                "get": "target"
              }
            }
          },
          {
            "each": {
              "get": "navigation.pages"
            },
            "as": "page",
            "children": [
              {
                "tag": "span",
                "attrs": {
                  "class": "pagination-ellipsis",
                  "aria-hidden": "true"
                },
                "children": [
                  "…"
                ],
                "when": {
                  "get": "page.gap_before"
                }
              },
              {
                "tag": "span",
                "attrs": {
                  "class": "pagination-link is-active",
                  "aria-current": "page"
                },
                "children": [
                  {
                    "get": "page.number"
                  }
                ],
                "when": {
                  "get": "page.current"
                }
              },
              {
                "tag": "a",
                "attrs": {
                  "class": "pagination-link",
                  "href": {
                    "get": "page.url"
                  },
                  "data-ajax": "",
                  "data-ajax-target": {
                    "get": "target"
                  },
                  "data-history": {
                    "get": "page.history_url"
                  }
                },
                "children": [
                  {
                    "get": "page.number"
                  }
                ],
                "when": {
                  "not": {
                    "get": "page.current"
                  }
                }
              }
            ]
          },
          {
            "component": "ui/pagination-step",
            "data": {
              "step": {
                "get": "navigation.next"
              },
              "kind": "next",
              "icon": "chevron-right",
              "label": {
                "t": "common.next"
              },
              "target": {
                "get": "target"
              }
            }
          }
        ]
      }
    ],
    "when": {
      "get": "navigation.visible"
    }
  },
  "ui/api-action": {
    "tag": "form",
    "attrs": {
      "class": "inline-flex",
      "method": "post",
      "action": {
        "get": "url"
      },
      "data-api-method": {
        "get": "method"
      },
      "data-ajax-form": "",
      "data-ajax-target": {
        "get": "target"
      },
      "data-confirm": {
        "get": "confirm"
      },
      "data-confirm-variant": {
        "if": [
          {
            "get": "confirm"
          },
          "danger",
          null
        ]
      }
    },
    "children": [
      {
        "csrf": true
      },
      {
        "tag": "input",
        "attrs": {
          "type": "hidden",
          "name": "_method",
          "value": {
            "get": "method"
          }
        },
        "children": []
      },
      {
        "each": {
          "get": "fields"
        },
        "as": "value",
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": {
                "get": "_key"
              },
              "value": {
                "get": "value"
              }
            },
            "children": []
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": {
            "or": [
              {
                "get": "button_class"
              },
              "btn btn-sm btn-ghost"
            ]
          },
          "type": "submit",
          "aria-label": {
            "get": "label"
          },
          "title": {
            "if": [
              {
                "get": "icon"
              },
              {
                "get": "label"
              },
              null
            ]
          }
        },
        "children": [
          {
            "icon": {
              "get": "icon"
            },
            "when": {
              "get": "icon"
            }
          },
          {
            "tag": "span",
            "attrs": {
              "class": {
                "if": [
                  {
                    "and": [
                      {
                        "get": "icon"
                      },
                      {
                        "not": {
                          "get": "show_label"
                        }
                      }
                    ]
                  },
                  "sr-only",
                  null
                ]
              }
            },
            "children": [
              {
                "get": "label"
              }
            ]
          }
        ]
      }
    ]
  },
  "ui/modal": {
    "tag": "div",
    "attrs": {
      "get": "root_attributes"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "modal-backdrop"
        },
        "children": []
      },
      {
        "tag": {
          "if": [
            {
              "get": "form"
            },
            "form",
            "div"
          ]
        },
        "attrs": {
          "get": "panel_attributes"
        },
        "children": [
          {
            "csrf": true,
            "when": {
              "get": "csrf"
            }
          },
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": "_method",
              "value": {
                "get": "hidden_method"
              }
            },
            "children": [],
            "when": {
              "get": "hidden_method"
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "modal-header"
            },
            "children": [
              {
                "tag": "h2",
                "attrs": {
                  "class": "text-lg m-0 cluster gap-2",
                  "id": {
                    "get": "title_id"
                  }
                },
                "children": [
                  {
                    "icon": {
                      "get": "icon"
                    },
                    "when": {
                      "get": "icon"
                    }
                  },
                  {
                    "get": "title"
                  }
                ]
              },
              {
                "tag": "button",
                "attrs": {
                  "class": "btn btn-sm btn-ghost btn-icon",
                  "type": "button",
                  "data-modal-close": "",
                  "aria-label": {
                    "get": "close_label"
                  }
                },
                "children": [
                  {
                    "slot": {
                      "get": "close_icon"
                    }
                  }
                ]
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": {
                "or": [
                  {
                    "get": "body_class"
                  },
                  "modal-body"
                ]
              }
            },
            "children": [
              {
                "slot": {
                  "get": "body"
                }
              }
            ]
          },
          {
            "tag": "div",
            "attrs": {
              "class": "modal-footer"
            },
            "children": [
              {
                "slot": {
                  "get": "footer"
                }
              }
            ],
            "when": {
              "get": "has_footer"
            }
          }
        ]
      }
    ]
  },
  "ui/captcha": {
    "tag": "div",
    "attrs": {
      "class": "field captcha-provider",
      "data-captcha": "",
      "data-captcha-provider": {
        "get": "config.provider"
      },
      "data-captcha-sitekey": {
        "get": "config.site_key"
      },
      "data-captcha-context": {
        "get": "config.context"
      },
      "data-captcha-theme": "auto"
    },
    "children": [
      {
        "tag": "span",
        "attrs": {
          "class": "label"
        },
        "children": [
          {
            "t": "security.captcha_label",
            "values": {}
          }
        ]
      },
      {
        "tag": "div",
        "attrs": {
          "class": "captcha-widget",
          "data-captcha-widget": ""
        },
        "children": []
      }
    ],
    "when": {
      "get": "config.enabled"
    }
  },
  "ui/search-form": {
    "tag": "form",
    "attrs": {
      "class": "admin-search-form",
      "method": "get",
      "action": {
        "get": "url"
      },
      "data-api-method": "GET",
      "data-ajax-form": "",
      "data-ajax-target": {
        "get": "target"
      },
      "data-history": {
        "get": "history"
      }
    },
    "children": [
      {
        "each": {
          "get": "filters"
        },
        "as": "value",
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": {
                "get": "_key"
              },
              "value": {
                "get": "value"
              }
            },
            "children": [],
            "when": {
              "not": {
                "eq": [
                  {
                    "get": "_key"
                  },
                  "q"
                ]
              }
            }
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "type": "hidden",
          "name": "per_page",
          "value": {
            "get": "pagination.per_page"
          }
        },
        "children": []
      },
      {
        "tag": "span",
        "attrs": {
          "class": "input-icon"
        },
        "children": [
          {
            "icon": "search"
          },
          {
            "tag": "input",
            "attrs": {
              "class": "input",
              "type": "search",
              "name": "q",
              "value": {
                "get": "filters.q"
              },
              "aria-label": {
                "t": "common.search",
                "values": {}
              }
            },
            "children": []
          }
        ]
      }
    ]
  },
  "ui/per-page": {
    "tag": "form",
    "attrs": {
      "class": "admin-per-page-form",
      "method": "get",
      "action": {
        "get": "url"
      },
      "data-api-method": "GET",
      "data-ajax-form": "",
      "data-ajax-target": {
        "get": "target"
      },
      "data-history": {
        "get": "history"
      }
    },
    "children": [
      {
        "each": {
          "get": "filters"
        },
        "as": "value",
        "children": [
          {
            "tag": "input",
            "attrs": {
              "type": "hidden",
              "name": {
                "get": "_key"
              },
              "value": {
                "get": "value"
              }
            },
            "children": []
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "type": "hidden",
          "name": "page",
          "value": "1"
        },
        "children": []
      },
      {
        "tag": "label",
        "attrs": {
          "class": "field-inline"
        },
        "children": [
          {
            "tag": "span",
            "attrs": {
              "class": "sr-only"
            },
            "children": [
              {
                "t": "common.per_page",
                "values": {}
              }
            ]
          },
          {
            "tag": "select",
            "attrs": {
              "class": "select select-sm",
              "name": "per_page",
              "data-submit-on-change": ""
            },
            "children": [
              {
                "each": {
                  "get": "choices"
                },
                "as": "choice",
                "children": [
                  {
                    "tag": "option",
                    "attrs": {
                      "value": {
                        "get": "_key"
                      },
                      "selected": {
                        "if": [
                          {
                            "eq": [
                              {
                                "string": {
                                  "get": "_key"
                                }
                              },
                              {
                                "string": {
                                  "get": "pagination.per_page"
                                }
                              }
                            ]
                          },
                          true,
                          null
                        ]
                      }
                    },
                    "children": [
                      {
                        "get": "choice"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "ui/list-toolbar": {
    "tag": "div",
    "attrs": {
      "class": "stack stack-gap-8"
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "admin-list-toolbar"
        },
        "children": [
          {
            "component": "ui/search-form",
            "data": {
              "url": {
                "get": "url"
              },
              "target": {
                "get": "target"
              },
              "history": {
                "get": "history"
              },
              "filters": {
                "get": "filters"
              },
              "pagination": {
                "get": "pagination"
              }
            }
          },
          {
            "tag": "div",
            "attrs": {
              "class": "admin-filter-actions"
            },
            "children": [
              {
                "component": "ui/filter-trigger",
                "data": {
                  "id": {
                    "get": "filter_modal"
                  }
                },
                "when": {
                  "get": "filter_modal"
                }
              },
              {
                "component": "ui/per-page",
                "data": {
                  "url": {
                    "get": "url"
                  },
                  "target": {
                    "get": "target"
                  },
                  "history": {
                    "get": "history"
                  },
                  "filters": {
                    "get": "filters"
                  },
                  "pagination": {
                    "get": "pagination"
                  },
                  "choices": {
                    "10": "10",
                    "25": "25",
                    "50": "50",
                    "100": "100"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "component": "ui/list-summary",
        "data": {
          "target": {
            "get": "target"
          },
          "filters": {
            "get": "filters"
          }
        }
      }
    ]
  },
  "ui/avatar": {
    "tag": "span",
    "attrs": {
      "class": {
        "concat": [
          "avatar",
          {
            "if": [
              {
                "get": "small"
              },
              " avatar-sm",
              ""
            ]
          }
        ]
      },
      "data-avatar-user-id": {
        "get": "user.id"
      }
    },
    "children": [
      {
        "component": "ui/avatar-content",
        "data": {
          "user": {
            "get": "user"
          },
          "alt": {
            "get": "alt"
          },
          "fallback_icon": {
            "get": "fallback_icon"
          }
        }
      }
    ]
  },
  "ui/avatar-content": [
    {
      "tag": "img",
      "attrs": {
        "src": {
          "get": "user.avatar_url"
        },
        "alt": {
          "or": [
            {
              "get": "alt"
            },
            {
              "get": "user.username"
            },
            "Avatar"
          ]
        },
        "loading": "lazy",
        "data-user-avatar-image": "",
        "data-avatar-user-id": {
          "get": "user.id"
        }
      },
      "children": [],
      "when": {
        "get": "user.avatar_url"
      }
    },
    {
      "tag": "span",
      "attrs": {
        "class": "avatar-fallback",
        "data-user-avatar-fallback": "",
        "data-avatar-user-id": {
          "get": "user.id"
        },
        "hidden": {
          "if": [
            {
              "get": "user.avatar_url"
            },
            true,
            null
          ]
        }
      },
      "children": [
        {
          "icon": {
            "or": [
              {
                "get": "fallback_icon"
              },
              "user"
            ]
          }
        }
      ]
    }
  ],
  "ui/modal-trigger": {
    "tag": "button",
    "attrs": {
      "class": {
        "get": "class"
      },
      "type": "button",
      "data-modal-open": {
        "get": "modal"
      },
      "data-modal-url": {
        "get": "url"
      },
      "aria-label": {
        "get": "label"
      },
      "title": {
        "get": "label"
      }
    },
    "children": [
      {
        "icon": {
          "get": "icon"
        }
      },
      {
        "tag": "span",
        "attrs": {},
        "children": [
          {
            "get": "label"
          }
        ],
        "when": {
          "not": {
            "get": "icon_only"
          }
        }
      }
    ]
  },
  "ui/admin-list": {
    "tag": "section",
    "attrs": {
      "class": "card",
      "aria-label": {
        "if": [
          {
            "get": "primary"
          },
          {
            "get": "title"
          },
          null
        ]
      }
    },
    "children": [
      {
        "tag": "div",
        "attrs": {
          "class": "card-header split"
        },
        "children": [
          {
            "tag": "h2",
            "attrs": {
              "class": "text-lg m-0 cluster gap-2"
            },
            "children": [
              {
                "icon": {
                  "get": "icon"
                }
              },
              {
                "get": "title"
              }
            ]
          },
          {
            "component": "ui/filter-trigger",
            "data": {
              "id": {
                "get": "filter_modal"
              }
            },
            "when": {
              "get": "filter_modal"
            }
          }
        ],
        "when": {
          "not": {
            "get": "primary"
          }
        }
      },
      {
        "tag": "div",
        "attrs": {
          "class": "card-body",
          "id": {
            "get": "target_id"
          }
        },
        "children": [
          {
            "slot": {
              "get": "content"
            }
          }
        ]
      }
    ]
  },
  "ui/account-status": {
    "component": "ui/status-badge",
    "data": {
      "tone": {
        "if": [
          {
            "eq": [
              {
                "get": "status"
              },
              "active"
            ]
          },
          "ok",
          "critical"
        ]
      },
      "label": {
        "get": "label"
      }
    }
  },
  "ui/pagination-step": {
    "tag": {
      "if": [
        {
          "get": "step"
        },
        "a",
        "span"
      ]
    },
    "attrs": {
      "class": {
        "concat": [
          "pagination-link pagination-",
          {
            "get": "kind"
          }
        ]
      },
      "href": {
        "get": "step.url"
      },
      "data-history": {
        "get": "step.history_url"
      },
      "data-ajax": {
        "if": [
          {
            "get": "step"
          },
          "",
          null
        ]
      },
      "data-ajax-target": {
        "if": [
          {
            "get": "step"
          },
          {
            "get": "target"
          },
          null
        ]
      },
      "aria-label": {
        "get": "label"
      },
      "title": {
        "get": "label"
      },
      "aria-disabled": {
        "if": [
          {
            "get": "step"
          },
          null,
          "true"
        ]
      }
    },
    "children": [
      {
        "icon": {
          "get": "icon"
        }
      },
      {
        "tag": "span",
        "attrs": {
          "class": "sr-only"
        },
        "children": [
          {
            "get": "label"
          }
        ]
      }
    ]
  },
  "ui/sort-heading": [
    {
      "tag": "a",
      "attrs": {
        "class": "table-sort",
        "href": {
          "get": "order.url"
        },
        "data-ajax": true,
        "data-ajax-target": {
          "get": "order.target"
        },
        "data-history": {
          "get": "order.history"
        }
      },
      "children": [
        {
          "tag": "span",
          "children": [
            {
              "get": "label"
            }
          ]
        },
        {
          "tag": "span",
          "attrs": {
            "class": "table-sort-indicator",
            "aria-hidden": "true",
            "data-active": {
              "or": [
                {
                  "get": "order.ascending"
                },
                {
                  "get": "order.descending"
                }
              ]
            }
          },
          "children": [
            {
              "icon": {
                "if": [
                  {
                    "get": "order.descending"
                  },
                  "arrow-down",
                  "arrow-up"
                ]
              }
            }
          ]
        }
      ],
      "when": {
        "get": "order"
      }
